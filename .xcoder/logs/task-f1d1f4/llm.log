[2026-11-16T10:16:33.993Z] [test-st-bf6f22] [request] Observation: {"ok":true,"sections":[{"label":"--- xcoder-dojo/src/main.tsx (lines 1-29 of 29) ---","content":"// xcoder:version 1 | xcoder:task task-f1d1f4 | xcoder:updated 2026-11-16T09:33:52.950Z | xcoder:subtask code-st-1de5aa\n/**\n * Entry point. Builds the demo bridge and mounts the shell inside the provider.\n * The bridge is created once and passed down; no component constructs its own\n * privileged channel.\n */\n\nimport { StrictMode } from 'react';\nimport { createRoot } from 'react-dom/client';\nimport { createDemoBridge } from './backend/demo-bridge';\nimport { AppProvider } from './ui/AppProvider';\nimport { App } from './ui/App';\nimport './ui/styles.css';\n\nconst bridge = createDemoBridge({ autoConfigureModel: true });\nconst container = document.getElementById('root');\n\nif (!container) {\n  throw new Error('Root container not found');\n}\n\ncreateRoot(container).render(\n  <StrictMode>\n    <AppProvider bridge={bridge}>\n      <App />\n    </AppProvider>\n  </StrictMode>,\n);\n","totalLines":29,"sliced":false},{"label":"--- xcoder-dojo/src/backend/__tests__/demo-bridge.test.ts (lines 1-45 of 397) ---","content":"// xcoder:version 3 | xcoder:task task-f1d1f4 | xcoder:updated 2026-11-16T10:06:28.383Z | xcoder:subtask test-st-bf6f22\n/**\n * Bridge integration tests.\n *\n * The bridge is the only privileged surface the UI can reach, so these tests\n * exercise it the way a page would: through BridgeResult envelopes only. The\n * intent they encode is the design's security posture - no workspace means no\n * reads, the tree and the agent see the same filtered view, writes from the\n * agent need a human approval that is bound to that specific call, only one\n * run may be in flight, and the API key is write-only forever.\n */\n\nimport { describe, expect, it } from 'vitest';\nimport { createDemoBridge } from '../demo-bridge';\nimport type { BridgeResult, DojoBridge, ApprovalRequest } from '../../contracts';\n\nconst NOW = 1_700_000_000_000;\n\nfunction newBridge(autoConfigureModel = true): DojoBridge {\n  return createDemoBridge({ now: () => NOW, autoConfigureModel });\n}\n\nasync function opened(): Promise<DojoBridge> {\n  const bridge = newBridge();\n  const result = await bridge.workspace.open('C:/projects/dojo-demo');\n  expect(result.ok).toBe(true);\n  return bridge;\n}\n\nfunction codeOf<T>(result: BridgeResult<T>): string | null {\n  return result.ok ? null : result.error.code;\n}\n\nasync function waitForPending(bridge: DojoBridge): Promise<ApprovalRequest> {\n  for (let i = 0; i < 50; i += 1) {\n    const pending = await bridge.approval.pending();\n    if (pending.ok && pending.value) return pending.value;\n    await new Promise((resolve) => setTimeout(resolve, 1));\n  }\n  throw new Error('no approval request was raised');\n}\n\ndescribe('workspace lifecycle', () => {\n  it('starts with no workspace and refuses reads', async () => {\n    const bridge = newBridge();","totalLines":397,"sliced":true}],"totalChars":2759,"dropped":0}
[2026-11-16T10:16:46.271Z] [test-st-bf6f22] [stop=end_turn] [response] All unit tests and smoke pass. Now I'll add regression tests: one that directly catches the leaked approval-expiry timer, and one covering `main.tsx` mount wiring (currently untested).\n\n{\n  "thought": "Write a focused regression test using fake timers: after an approval is resolved, the expiry timer must be cleared (getTimerCount drops to 0). Before the fix it stayed registered for 120s.",\n  "action": {\n    "tool": "write_file",\n    "input": {\n      "path": "xcoder-dojo/src/backend/__tests__/approval-timer.test.ts",\n      "content": "// xcoder:version 1 | xcoder:task task-f1d1f4 | xcoder:updated 2026-11-16T10:20:00.000Z | xcoder:subtask test-st-bf6f22\n/**\n * Regression tests for approval expiry timers.\n *\n * Intent encoded here (from the design's approval-sheet requirements): an\n * approval request is time-bounded, and once it is answered the request is\n * finished. \"Finished\" must include releasing the expiry timer.\n *\n * Why this matters beyond tidiness: a dangling 120s expiry timer keeps the\n * Node event loop alive, so any process that imports the bridge (the smoke\n * runner, CI, a future headless CLI) never exits even though all work is done.\n * That is exactly how `npm run regression` failed - it hung instead of exiting.\n */\n\nimport { afterEach, describe, expect, it, vi } from 'vitest';\nimport { createDemoBridge } from '../demo-bridge';\nimport type { DojoBridge } from '../../contracts';\n\nconst NOW = 1_700_000_000_000;\n\nfunction newBridge(): DojoBridge {\n  return createDemoBridge({ now: () => NOW, autoConfigureModel: true });\n}\n\nasync function pendingId(bridge: DojoBridge): Promise<string> {\n  for (let i = 0; i < 50; i += 1) {\n    const pending = await bridge.approval.pending();\n    if (pending.ok && pending.value) return pending.value.approvalId;\n    await Promise.resolve();\n  }\n  throw new Error('no approval request was raised');\n}\n\nafterEach(() => {\n  vi.useRealTimers();\n});\n\ndescribe('approval expiry timer lifecycle', () => {\n  it('arms an expiry timer while an approval is pending', async () => {\n    vi.useFakeTimers();\n    const bridge = newBridge();\n\n    void bridge.delegation.launch({ goal: 'rename a symbol' });\n    await pendingId(bridge);\n\n    // The pending approval is bounded in time: exactly one expiry timer is\n    // outstanding while it waits for a human.\n    expect(vi.getTimerCount()).toBe(1);\n  });\n\n  it('clears the expiry timer when the approval is denied', async () => {\n    vi.useFakeTimers();\n    const bridge = newBridge();\n\n    const launch = bridge.delegation.launch({ goal: 'rename a symbol' });\n    const approvalId = await pendingId(bridge);\n\n    const decision = await bridge.approval.respond({ approvalId, decision: 'denied' });\n    expect(decision.ok && decision.value).toBe('denied');\n\n    // THE REGRESSION: a resolved approval must not leave its expiry timer\n    // registered, or the event loop stays alive for the full 120s TTL.\n    expect(vi.getTimerCount()).toBe(0);\n\n    const result = await launch;\n    expect(result.ok).toBe(false);\n    if (!result.ok) expect(result.error.code).toBe('approval-denied');\n  });\n\n  it('clears the expiry timer when the approval is approved', async () => {\n    vi.useFakeTimers();\n    const bridge = newBridge();\n\n    const launch = bridge.delegation.launch({ goal: 'rename a symbol' });\n    const approvalId = await pendingId(bridge);\n\n    const decision = await bridge.approval.respond({ approvalId, decision: 'approved' });\n    expect(decision.ok && decision.value).toBe('approved');\n\n    // The delegation run itself schedules its own chunk timers, so assert the\n    // expiry timer specifically is gone rather than that no timers exist.\n    const run = await launch;\n    expect(run.ok).toBe(true);\n\n    // Drain the simulated run, then assert the loop is empty: nothing of the\n    // approval's remains.\n    await vi.advanceTimersByTimeAsync(10_000);\n    expect(vi.getTimerCount()).toBe(0);\n  });\n\n  it('expires a pending approval once the TTL elapses', async () => {\n    vi.useFakeTimers();\n    const bridge = newBridge();\n\n    const launch = bridge.delegation.launch({ goal: 'rename a symbol' });\n    const approvalId = await pendingId(bridge);\n\n    await vi.advanceTimersByTimeAsync(120_000);\n\n    const result = await launch;\n    expect(result.ok).toBe(false);\n    if (!result.ok) expect(result.error.code).toBe('approval-expired');\n\n    // A late human response to an expired request is refused, not honoured.\n    const late = await bridge.approval.respond({ approvalId, decision: 'approved' });\n    expect(late.ok).toBe(false);\n    if (!late.ok) expect(late.error.code).toBe('approval-expired');\n  });\n});\n"\n    }\n  }\n}
