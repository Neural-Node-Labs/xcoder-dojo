onst Tag = `h${block.level}` as 'h1';\n      return (\n        <Tag className=\"md-heading\">\n          <Spans spans={block.spans} />\n        </Tag>\n      );\n    }\n    case 'paragraph':\n      return (\n        <p className=\"md-p\">\n          <Spans spans={block.spans} />\n        </p>\n      );\n    case 'code':\n      return (\n        <pre className=\"md-pre\">\n          <code>{block.text}</code>\n        </pre>\n      );\n    case 'list': {\n      const Tag = block.ordered ? 'ol' : 'ul';\n      return (\n        <Tag className=\"md-list\">\n          {block.items.map((item, index) => (\n            <li key={index}>\n              <Spans spans={item} />\n            </li>\n          ))}\n        </Tag>\n      );\n    }\n    case 'quote':\n      return (\n        <blockquote className=\"md-quote\">\n          <Spans spans={block.spans} />\n        </blockquote>\n      );\n    case 'rule':\n      return <hr className=\"md-rule\" />;\n    default:\n      return null;\n  }\n}\n\nexport function MarkdownView({ model }: { model: MarkdownPreviewModel }): JSX.Element {\n  const htmlNote = model.strippedHtmlBlocks > 0 ? ` \\u00b7 ${model.strippedHtmlBlocks} HTML block(s) stripped` : '';\n  const imgNote = model.blockedImages > 0 ? ` \\u00b7 ${model.blockedImages} image(s) blocked` : '';\n  return (\n    <div className=\"markdown-view\">\n      <div className=\"md-banner\">\n        Sanitized preview &mdash; raw HTML is never rendered\n        {htmlNote}\n        {imgNote}\n      </div>\n      <article className=\"md-body\">\n        {model.blocks.map((block, index) => (\n          <Block key={index} block={block} />\n        ))}\n      </article>\n    </div>\n  );\n}\n","totalLines":121,"sliced":false},{"label":"--- xcoder-dojo/src/ui/components/StatusBar.tsx (lines 1-62 of 62) ---","content":"// xcoder:version 1 | xcoder:task task-f1d1f4 | xcoder:updated 2026-11-16T09:31:32.753Z | xcoder:subtask code-st-1de5aa\n/**\n * P-11 Status bar. Persistent chrome, view-onl