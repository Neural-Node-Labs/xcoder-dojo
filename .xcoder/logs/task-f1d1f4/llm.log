rt text').toBeDefined();\n  });\n\n  it.each(['http://example.com/a', 'https://example.com/a', 'mailto:dev@example.com'])(\n    'keeps the safe scheme %s as a link span',\n    (href) => {\n      const spans = spansOf(`click [me](${href})\\n`);\n      const link = spans.find((s) => s.kind === 'link');\n      expect(link).toMatchObject({ kind: 'link', text: 'me', href });\n    },\n  );\n\n  it('keeps root-relative and fragment destinations as links', () => {\n    const relative = spansOf('go [here](/docs/page)\\n').find((s) => s.kind === 'link');\n    const fragment = spansOf('go [there](#section-1)\\n').find((s) => s.kind === 'link');\n    expect(relative).toMatchObject({ kind: 'link', href: '/docs/page', external: false });\n    expect(fragment).toMatchObject({ kind: 'link', href: '#section-1', external: false });\n  });\n\n  it('still flags http(s) destinations as external', () => {\n    const https = spansOf('go [here](https://example.com/x)\\n').find((s) => s.kind === 'link');\n    const http = spansOf('go [here](http://example.com/x)\\n').find((s) => s.kind === 'link');\n    expect(https).toMatchObject({ external: true });\n    expect(http).toMatchObject({ external: true });\n  });\n\n  it('does not treat a label containing a colon as a scheme', () => {\n    const spans = spansOf('see [note: read me](/docs/note)\\n');\n    expect(spans.find((s) => s.kind === 'link')).toMatchObject({ kind: 'link', href: '/docs/note' });\n  });\n});"}}}\n\n{"thought":"Also add a render-level test covering data:/mixed-case variants. Let me first verify the new parser tests pass, then extend render test.","action":{"tool":"run_command","input":{"command":"cd /d xcoder-dojo && npx vitest run src/backend/__tests__/markdown.test.ts 2>&1","timeoutMs":300000}}}
