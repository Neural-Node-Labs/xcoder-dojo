[2026-11-16T09:59:59.008Z] [test-st-bf6f22] [request] Observation: {"ok":true,"content":"function argString(inv: ToolInvocation, key: string, fallback: string): string {\n  const value = inv.args[key];\n  return typeof value === 'string' ? value : fallback;\n}\n\nfunction sortedEntries(vfs: Vfs, parent: string): VfsEntry[] {\n  return listDir(vfs, parent).sort((a, b) => {\n    if (a.kind !== b.kind) return a.kind === 'dir' ? -1 : 1;\n    return a.relPath.localeCompare(b.relPath);\n  });\n}\n\nfunction globToRegExp(pattern: string): RegExp {\n  const escaped = pattern\n    .replace(/[.+^${}()|[\\]\\\\]/g, '\\\\$&')\n    .replace(/\\*\\*\\//g, '\\u0001')\n    .replace(/\\*\\*/g, '\\u0002')\n    .replace(/\\*/g, '[^/]*')\n    .replace(/\\?/g, '[^/]')\n    .replace(/\\u0001/g, '(?:.*/)?')\n    .replace(/\\u0002/g, '.*');\n  return new RegExp(`^${escaped}$`);\n}\n\nfunction classifyRefusal(message: string): ToolCallOutcome {","relPath":"xcoder-dojo/src/backend/tools.ts","totalLines":217,"readSha1":"e947795173841a2b5123d83e718d96ed468e0363"}
