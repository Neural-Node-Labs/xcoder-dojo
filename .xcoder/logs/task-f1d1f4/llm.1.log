[2026-11-16T09:27:28.057Z] [code-st-1de5aa] [stop=end_turn] [response] <thought>Dependencies installed. Now I'll build the source. Starting with the shared contract layer (errors, action descriptors, all page models, DojoBridge).</thought>\n<action>\n{\n  "tool": "write_file",\n  "input": {\n    "path": "xcoder-dojo/src/contracts.ts",\n    "content": "/**\n * Xcoder Dojo - shared contract layer.\n *\n * This module is the single source of truth for every type crossing a page\n * boundary: the closed AppError vocabulary, the ActionDescriptor shape with its\n * non-optional `requiresApproval`, the page models and the DojoBridge surface.\n *\n * Invariants (see design P-00 / T-03):\n *  - Every privileged action is validated and enforced in the backend\n *    (`enforcedIn: 'main'`), never in a component.\n *  - `requiresApproval` is not optional, so a new high-impact action cannot\n *    silently ship without a gate.\n *  - Model and file derived text is untrusted and only ever rendered escaped.\n */\n\n/* ------------------------------------------------------------------ errors */\n\nexport type AppErrorCode =\n  | 'path-escape'\n  | 'credential-file'\n  | 'excluded-dir'\n  | 'binary-file'\n  | 'not-utf8'\n  | 'file-too-large'\n  | 'outside-workspace'\n  | 'denied-credential'\n  | 'missing'\n  | 'conflict'\n  | 'no-workspace'\n  | 'run-busy'\n  | 'runtime-missing'\n  | 'turn-limit'\n  | 'request-cap'\n  | 'tool-not-allowlisted'\n  | 'tool-failed'\n  | 'approval-expired'\n  | 'approval-denied'\n  | 'approval-required'\n  | 'secret-detected'\n  | 'invalid-input'\n  | 'model-not-configured'\n  | 'delegation-busy'\n  | 'internal';\n\nexport interface AppError {\n  code: AppErrorCode;\n  /** Already redacted; safe to render as escaped text. */\n  message: string;\n  remediation?: string;\n  detailRef?: string;\n}\n\nexport type BridgeResult<T> = { ok: true; value: T } | { ok: false; error: AppError };\n\nexport function bridgeOk<T>(value: T): BridgeResult<T> {\n  return { ok: true, value };\n}\n\nexport function bridgeErr<T = never>(\n  code: AppErrorCode,\n  message: string,\n  remediation?: string,\n): BridgeResult<T> {\n  const error: AppError = { code, message };\n  if (remediation) error.remediation = remediation;\n  return { ok: false, error };\n}\n\n/** Thrown inside action implementations; the bridge turns it into a BridgeResult. */\nexport class ActionError extends Error {\n  readonly code: AppErrorCode;\n  readonly remediation?: string;\n\n  constructor(code: AppErrorCode, message: string, remediation?: string) {\n    super(message);\n    this.name = 'ActionError';\n    this.code = code;\n    if (remediation) this.remediation = remediation;\n  }\n\n  toAppError(): AppError {\n    const e: AppError = { code: this.code, message: this.message };\n    if (this.remediation) e.remediation = this.remediation;\n    return e;\n  }\n}\n\n/* ------------------------------------------------------------ input guards */\n\nexport function isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === 'object' && value !== null && !Array.isArray(value);\n}\n\nexport function requireString(raw: unknown, field: string, maxLength = 200_000): string {\n  if (typeof raw !== 'string') {\n    throw new ActionError('invalid-input', `${field} must be a string`);\n  }\n  if (raw.length > maxLength) {\n    throw new ActionError('invalid-input', `${field} exceeds the ${maxLength} character limit`);\n  }\n  return raw;\n}\n\nexport function requireBoolean(raw: unknown, field: string): boolean {\n  if (typeof raw !== 'boolean') {\n    throw new ActionError('invalid-input', `${field} must be a boolean`);\n  }\n  return raw;\n}\n\nexport function requireNumber(raw: unknown, field: string): number {\n  if (typeof raw !== 'number' || !Number.isFinite(raw)) {\n    throw new ActionError('invalid-input', `${field} must be a finite number`);\n  }\n  return raw;\n}\n\nexport function requireOneOf<T extends string>(\n  raw: unknown,\n  field: string,\n  allowed: readonly T[],\n): T {\n  if (typeof raw !== 'string' || !(allowed as readonly string[]).includes(raw)) {\n    throw new ActionError('invalid-input', `${field} must be one of: ${allowed.join(', ')}`);\n  }\n  return raw as T;\n}\n\n/* --------------------------------------------------------- action contract */\n\nexport type SideEffectClass = 'none' | 'read' | 'write' | 'execute' | 'secret';\nexport type ActorOrigin = 'user' | 'agent' | 'system';\n\nexport interface ActionContext {\n  origin: ActorOrigin;\n  approvalId?: string;\n  nowMs: number;\n}\n\nexport interface ActionDescriptor<In, Out> {\n  readonly name: string;\n  readonly sideEffect: SideEffectClass;\n  /** Non-optional by design: a high-impact action cannot lack a gate. */\n  readonly requiresApproval: boolean;\n  readonly enforcedIn: 'main';\n  /** Already redacted human summary used in the approval sheet and audit log. */\n  readonly summarize: (input: In) => string;\n  readonly validate: (raw: unknown) => In;\n  readonly run: (input: In, ctx: ActionContext) => Promise<Out>;\n}\n\n/* --------------------------------------------------------------- workspace */\n\nexport interface WorkspaceInfo {\n  workspaceId: string;\n  rootLabel: string;\n  rootDisplayPath: string;\n  openedAtMs: number;\n}\n\nexport interface RecentWorkspace {\n  rootDisplayPath: string;\n  label: string;\n  lastOpenedAtMs: number;\n}\n\nexport interface WelcomeModel {\n  recents: readonly RecentWorkspace[];\n  modelState: 'configured' | 'missing' | 'error';\n  modelLabel: string | null;\n}\n\n/* -------------------------------------------------------------- file tree */\n\nexport type SupportedLanguage =\n  | 'typescript'\n  | 'javascript'\n  | 'json'\n  | 'markdown'\n  | 'css'\n  | 'html'\n  | 'python'\n  | 'text'\n  | 'binary';\n\nexport interface FileNode {\n  nodeId: string;\n  relPath: string;\n  name: string;\n  kind: 'file' | 'dir';\n  hasChildren: boolean;\n  language?: SupportedLanguage;\n  sizeBytes?: number;\n  mtimeMs?: number;\n}\n\nexport interface ListChildrenRequest {\n  parentRelPath: string | null;\n  cursor?: string;\n  limit?: number;\n}\n\nexport interface TreeNodePage {\n  parentRelPath: string | null;\n  entries: readonly FileNode[];\n  nextCursor: string | null;\n  truncated: boolean;\n  scannedFiles: number;\n}\n\nexport interface ExplorerModel {\n  workspaceRootLabel: string;\n  nodesByParent: Readonly<Record<string, TreeNodePage>>;\n  expandedRelPaths: readonly string[];\n  selection: { relPath: string; kind: 'file' | 'dir' } | null;\n  filter: { text: string; applied: boolean };\n  loadingParents: readonly string[];\n}\n\nexport type NodeContextAction = 'open' | 'reveal' | 'copyRelativePath' | 'refresh' | 'run';\n\nexport interface NodeContextMenuModel {\n  relPath: string;\n  kind: 'file' | 'dir';\n  items: readonly {\n    action: NodeContextAction;\n    enabled: boolean;\n    disabledReason?: string;\n  }[];\n}\n\n/* ------------------------------------------------------------------ editor */\n\nexport type FileOpenErrorCode =\n  | 'binary-file'\n  | 'not-utf8'\n  | 'file-too-large'\n  | 'outside-workspace'\n  | 'denied-credential'\n  | 'missing';\n\nexport interface FileReadResult {\n  relPath: string;\n  content: string;\n  encoding: 'utf-8' | 'utf-8-bom';\n  eol: 'lf' | 'crlf';\n  language: SupportedLanguage;\n  sizeBytes: number;\n  truncated: boolean;\n  savedSha: string;\n}\n\nexport interface EditorTabState {\n  tabId: string;\n  relPath: string;\n  kind: 'text' | 'markdown' | 'error';\n  language: SupportedLanguage;\n  encoding: 'utf-8' | 'utf-8-bom';\n  eol: 'lf' | 'crlf';\n  dirty: boolean;\n  readOnly: boolean;\n  truncated: boolean;\n  errorCode?: FileOpenErrorCode;\n  savedSha: string | null;\n}\n\nexport interface SaveRequest {\n  tabId: string;\n  relPath: string;\n  content: string;\n  baseSha: string;\n  writeNewFile: boolean;\n}\n\nexport interface SaveResult {\n  ok: boolean;\n  relPath: string;\n  bytesWritten: number;\n  encoding: 'utf-8' | 'utf-8-bom';\n  eol: 'lf' | 'crlf';\n  savedSha: string;\n  savedAtMs: number;\n  error?: AppError;\n}\n\nexport interface EditorModel {\n  tabs: readonly EditorTabState[];\n  activeTabId: string | null;\n  splitPreview: { open: boolean; tabId: string | null };\n  saveInFlight: readonly string[];\n}\n\n/* ------------------------------------------------------------ markdown AST */\n\nexport type MarkdownSpan =\n  | { kind: 'text'; text: string }\n  | { kind: 'code'; text: string }\n  | { kind: 'strong'; text: string }\n  | { kind: 'em'; text: string }\n  | { kind: 'link'; text: string; href: string; external: boolean }\n  | { kind: 'blocked-image'; alt: string };\n\nexport type MarkdownBlock =\n  | { kind: 'heading'; level: 1 | 2 | 3 | 4 | 5 | 6; spans: readonly MarkdownSpan[] }\n  | { kind: 'paragraph'; spans: readonly MarkdownSpan[] }\n  | { kind: 'code'; language: string | null; text: string }\n  | { kind: 'list'; ordered: boolean; items: readonly (readonly MarkdownSpan[])[] }\n  | { kind: 'quote'; spans: readonly MarkdownSpan[] }\n  | { kind: 'rule' };\n\nexport interface MarkdownPreviewModel {\n  relPath: string;\n  blocks: readonly MarkdownBlock[];\n  blockedImages: number;\n  strippedHtmlBlocks: number;\n}\n\n/* -------------------------------------------------------------- run console */\n\nexport type RunState =\n  | 'idle'\n  | 'starting'\n  | 'running'\n  | 'stopping'\n  | 'succeeded'\n  | 'failed'\n  | 'stopped'\n  | 'rejected-busy';\n\nexport interface CommandSpec {\n  targetId: string;\n  label: string;\n  description: string;\n  argv: readonly string[];\n  envKeys: readonly string[];\n  /** True when the demo executor synthesises output instead of spawning a process. */\n  simulated: boolean;\n}\n\nexport interface RunStartRequest {\n  targetId: string;\n}\n\nexport interface ConsoleChunk {\n  chunkId: string;\n  stream: 'stdout' | 'stderr' | 'system';\n  text: string;\n  atMs: number;\n}\n\nexport interface RunSession {\n  runId: string;\n  targetId: string;\n  label: string;\n  argv: readonly string[];\n  state: RunState;\n  simulated: boolean;\n  startedAtMs: number;\n  endedAtMs: number | null;\n  exitCode: number | null;\n  chunks: readonly ConsoleChunk[];\n}\n\nexport type RunEvent =\n  | { type: 'run-started'; session: RunSession }\n  | { type: 'run-chunk'; runId: string; chunk: ConsoleChunk }\n  | { type: 'run-ended'; runId: string; state: RunState; exitCode: number | null };\n\n/* ------------------------------------------------------------------- agent */\n\nexport type AgentRequestState =\n  | 'idle'\n  | 'thinking'\n  | 'awaiting-tool'\n  | 'answering'\n  | 'stopping'\n  | 'done'\n  | 'stopped'\n  | 'turn-limit'\n  | 'request-cap'\n  | 'failed';\n\nexport type AllowlistedToolName =\n  | 'list_dir'\n  | 'glob'\n  | 'grep'\n  | 'read_file'\n  | 'read_multiple_files'\n  | 'read_file_lines'\n  | 'read_outline'\n  | 'validate_file'\n  | 'git_status'\n  | 'git_diff'\n  | 'git_log';\n\nexport const ALLOWLISTED_TOOLS: readonly AllowlistedToolName[] = [\n  'list_dir',\n  'glob',\n  'grep',\n  'read_file',\n  'read_multiple_files',\n  'read_file_lines',\n  'read_outline',\n  'validate_file',\n  'git_status',\n  'git_diff',\n  'git_log',\n];\n\nexport function isAllowlistedTool(name: unknown): name is AllowlistedToolName {\n  return typeof name === 'string' && (ALLOWLISTED_TOOLS as readonly string[]).includes(name);\n}\n\nexport type ToolCallOutcome =\n  | 'pending'\n  | 'ok'\n  | 'refused-sandbox'\n  | 'refused-credential'\n  | 'refused-excluded'\n  | 'denied-allowlist'\n  | 'denied-approval'\n  | 'schema-invalid'\n  | 'error';\n\nexport interface ToolCallRecord {\n  toolCallId: string;\n  toolName: AllowlistedToolName | string;\n  argsSummary: Readonly<Record<string, string | number | boolean>>;\n  argsRedacted: boolean;\n  outcome: ToolCallOutcome;\n  durationMs: number | null;\n  resultSummary: string | null;\n  resultTruncated: boolean;\n}\n\nexport interface TranscriptEntry {\n  entryId: string;\n  role: 'user' | 'assistant' | 'system';\n  origin: 'human' | 'model' | 'workspace-data';\n  text: string;\n  atMs: number;\n  streaming: boolean;\n  toolCallIds: readonly string[];\n  rejectionNotice?: { code: AppErrorCode; message: string };\n}\n\nexport interface AgentSendRequest {\n  text: string;\n  sessionId: string;\n  workspaceId: string;\n}\n\nexport type AgentEvent =\n  | { type: 'request-started'; requestId: string }\n  | { type: 'entry-started'; requestId: string; entry: TranscriptEntry }\n  | { type: 'delta'; requestId: string; entryId: string; text: string }\n  | { type: 'tool-call'; requestId: string; record: ToolCallRecord }\n  | { type: 'tool-call-updated'; requestId: string; record: ToolCallRecord }\n  | { type: 'entry-completed'; requestId: string; entryId: string }\n  | { type: 'request-ended'; requestId: string; state: AgentRequestState; reason?: AppError }\n  | { type: 'turn-progress'; requestId: string; turnCount: number; turnCap: number };\n\nexport interface AgentModel {\n  sessionId: string;\n  transcript: readonly TranscriptEntry[];\n  toolCallsById: Readonly<Record<string, ToolCallRecord>>;\n  request: {\n    requestId: string | null;\n    state: AgentRequestState;\n    turnCount: number;\n    turnCap: number;\n  };\n  modelState: 'configured' | 'missing' | 'error';\n  input: { draftText: string; maxChars: number };\n  requestCapRemaining: number;\n}\n\n/* -------------------------------------------------------------- delegation */\n\nexport type DelegationState =\n  | 'idle'\n  | 'launching'\n  | 'running'\n  | 'stopping'\n  | 'succeeded'\n  | 'failed'\n  | 'stopped'\n  | 'denied'\n  | 'rejected-busy';\n\nexport interface DelegationLaunchRequest {\n  goal: string;\n}\n\nexport interface DelegationChunk {\n  chunkId: string;\n  stream: 'stdout' | 'stderr' | 'system';\n  text: string;\n  atMs: number;\n}\n\nexport interface DelegationRun {\n  runId: string;\n  goal: string;\n  cliLabel: string;\n  state: DelegationState;\n  startedAtMs: number;\n  endedAtMs: number | null;\n  exitCode: number | null;\n  chunks: readonly DelegationChunk[];\n  simulated: boolean;\n}\n\nexport type DelegationEvent =\n  | { type: 'delegation-started'; run: DelegationRun }\n  | { type: 'delegation-chunk'; runId: string; chunk: DelegationChunk }\n  | { type: 'delegation-ended'; runId: string; state: DelegationState; exitCode: number | null };\n\n/* ---------------------------------------------------------------- approval */\n\nexport type ApprovalKind = 'file-write' | 'delegation-launch';\nexport type ApprovalDecision = 'approved' | 'denied' | 'expired';\n\nexport interface ApprovalRequest {\n  approvalId: string;\n  kind: ApprovalKind;\n  summary: string;\n  detailLines: readonly string[];\n  requestedAtMs: number;\n  expiresAtMs: number;\n}\n\nexport interface ApprovalResponseRequest {\n  approvalId: string;\n  decision: 'approved' | 'denied';\n}\n\n/* ---------------------------------------------------------------- settings */\n\nexport interface AgentLimits {\n  maxTurns: number;\n  maxInputChars: number;\n  requestCapPerHour: number;\n}\n\nexport type ThemeName = 'dojo-dark' | 'dojo-hud' | 'dojo-light';\n\nexport interface LlmSettingsView {\n  modelId: string;\n  modelLabel: string;\n  provider: string;\n  /** The API key itself is never part of any view. */\n  [REDACTED];\n  limits: AgentLimits;\n  delegationCliLabel: string;\n  theme: ThemeName;\n  auditRetentionDays: number;\n  modelState: 'configured' | 'missing' | 'error';\n  maxFileReadBytes: number;\n}\n\nexport interface LlmSettingsPatch {\n  modelId?: string;\n  theme?: ThemeName;\n  delegationCliLabel?: string;\n  auditRetentionDays?: number;\n  limits?: Partial<AgentLimits>;\n}\n\nexport interface ApiKeyInput {\n  [REDACTED];\n}\n\nexport interface SecretState {\n  [REDACTED];\n  updatedAtMs: number | null;\n}\n\n/* ----------------------------------------------------------------- history */\n\nexport interface SessionSummary {\n  sessionId: string;\n  title: string;\n  updatedAtMs: number;\n  entryCount: number;\n}\n\nexport interface SessionDetail {\n  sessionId: string;\n  title: string;\n  entries: readonly TranscriptEntry[];\n  toolCalls: readonly ToolCallRecord[];\n}\n\n/* ------------------------------------------------------------------- audit */\n\nexport type AuditEventType =\n  | 'workspace-open'\n  | 'workspace-close'\n  | 'file-save'\n  | 'run-start'\n  | 'run-stop'\n  | 'agent-request'\n  | 'agent-response'\n  | 'tool-call'\n  | 'tool-refusal'\n  | 'delegation-start'\n  | 'delegation-stop'\n  | 'approval-request'\n  | 'approval-decision'\n  | 'settings-change'\n  | 'secret-set'\n  | 'secret-cleared'\n  | 'error';\n\nexport interface AuditEventView {\n  eventId: string;\n  atMs: number;\n  type: AuditEventType;\n  actor: 'user' | 'agent' | 'system';\n  targetRelPath?: string;\n  toolName?: AllowlistedToolName;\n  outcome: 'ok' | 'refused' | 'denied' | 'failed';\n  redactedSummary: string;\n}\n\nexport interface AuditPageRequest {\n  cursor?: string;\n  limit?: number;\n  type?: AuditEventType;\n  sinceMs?: number;\n}\n\nexport interface AuditPage {\n  events: readonly AuditEventView[];\n  nextCursor: string | null;\n  retentionDays: number;\n}\n\nexport interface AuditLocation {\n  logDir: string;\n  retentionDays: number;\n}\n\n/* ------------------------------------------------------------------ status */\n\nexport interface StatusBarModel {\n  workspacePathDisplay: string | null;\n  run: { state: RunState; label: string };\n  agent: { state: AgentRequestState; label: string };\n  model: { state: 'configured' | 'missing' | 'error'; label: string };\n  audit: { logDir: string; retentionDays: number };\n  selection: { relPath: string; language: SupportedLanguage } | null;\n}\n\n/* ------------------------------------------------------------- error center */\n\nexport interface ErrorToast {\n  toastId: string;\n  error: AppError;\n  atMs: number;\n  dismissed: boolean;\n}\n\n/* ------------------------------------------------------------------- tools */\n\nexport interface ToolExecutionResult {\n  outcome: ToolCallOutcome;\n  summary: string;\n  truncated: boolean;\n  payload?: unknown;\n}\n\n/* ------------------------------------------------------------------ bridge */\n\nexport type BridgeEvent =\n  | { type: 'agent'; event: AgentEvent }\n  | { type: 'run'; event: RunEvent }\n  | { type: 'delegation'; event: DelegationEvent }\n  | { type: 'approval-requested'; request: ApprovalRequest }\n  | { type: 'approval-resolved'; approvalId: string; decision: ApprovalDecision }\n  | { type: 'audit'; event: AuditEventView }\n  | { type: 'settings-changed'; view: LlmSettingsView }\n  | { type: 'error'; error: AppError };\n\nexport type BridgeListener = (event: BridgeEvent) => void;\n\nexport interface WorkspaceApi {\n  current(): Promise<BridgeResult<WorkspaceInfo | null>>;\n  recents(): Promise<BridgeResult<readonly RecentWorkspace[]>>;\n  open(rootDisplayPath: string | null): Promise<BridgeResult<WorkspaceInfo>>;\n  close(): Promise<BridgeResult<null>>;\n}\n\nexport interface TreeApi {\n  listChildren(request: ListChildrenRequest): Promise<BridgeResult<TreeNodePage>>;\n}\n\nexport interface FilesApi {\n  read(relPath: string): Promise<BridgeResult<FileReadResult>>;\n  save(request: SaveRequest): Promise<BridgeResult<SaveResult>>;\n  /** Approval-gated write requested on the agent's behalf (kind: file-write). */\n  agentWrite(relPath: string, content: string): Promise<BridgeResult<SaveResult>>;\n  markdown(relPath: string): Promise<BridgeResult<MarkdownPreviewModel>>;\n}\n\nexport interface RunApi {\n  targets(): Promise<BridgeResult<readonly CommandSpec[]>>;\n  session(): Promise<BridgeResult<RunSession | null>>;\n  start(request: RunStartRequest): Promise<BridgeResult<RunSession>>;\n  stop(): Promise<BridgeResult<null>>;\n}\n\nexport interface AgentApi {\n  state(): Promise<BridgeResult<AgentModel>>;\n  send(request: AgentSendRequest): Promise<BridgeResult<{ requestId: string }>>;\n  stop(): Promise<BridgeResult<null>>;\n  retryLast(): Promise<BridgeResult<{ requestId: string }>>;\n  clearConversation(): Promise<BridgeResult<null>>;\n}\n\nexport interface SessionApi {\n  list(): Promise<BridgeResult<readonly SessionSummary[]>>;\n  load(sessionId: string): Promise<BridgeResult<SessionDetail>>;\n  clear(sessionId: string): Promise<BridgeResult<null>>;\n  clearAll(): Promise<BridgeResult<null>>;\n}\n\nexport interface DelegationApi {\n  current(): Promise<BridgeResult<DelegationRun | null>>;\n  launch(request: DelegationLaunchRequest): Promise<BridgeResult<DelegationRun>>;\n  stop(): Promise<BridgeResult<null>>;\n}\n\nexport interface ApprovalApi {\n  pending(): Promise<BridgeResult<ApprovalRequest | null>>;\n  respond(request: ApprovalResponseRequest): Promise<BridgeResult<ApprovalDecision>>;\n}\n\nexport interface SettingsApi {\n  get(): Promise<BridgeResult<LlmSettingsView>>;\n  patch(patch: LlmSettingsPatch): Promise<BridgeResult<LlmSettingsView>>;\n  setApiKey(input: ApiKeyInput): Promise<BridgeResult<SecretState>>;\n  clearApiKey(): Promise<BridgeResult<SecretState>>;\n}\n\nexport interface AuditApi {\n  page(request: AuditPageRequest): Promise<BridgeResult<AuditPage>>;\n  location(): Promise<BridgeResult<AuditLocation>>;\n}\n\nexport interface DojoBridge {\n  readonly workspace: WorkspaceApi;\n  readonly tree: TreeApi;\n  readonly files: FilesApi;\n  readonly run: RunApi;\n  readonly agent: AgentApi;\n  readonly session: SessionApi;\n  readonly delegation: DelegationApi;\n  readonly approval: ApprovalApi;\n  readonly settings: SettingsApi;\n  readonly audit: AuditApi;\n  subscribe(listener: BridgeListener): () => void;\n}\n"\n  }\n}</｜｜DSML｜｜ parameter>\n</｜｜DSML｜｜ invoke>\n</｜｜DSML｜｜ calls>
