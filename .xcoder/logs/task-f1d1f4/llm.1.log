px;\n  border-top: 1px solid var(--line-soft);\n  font-size: 10.5px;\n  line-height: 1.4;\n}\n\n.status-bar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0 10px;\n  background: var(--bg-2);\n  border-top: 1px solid var(--line);\n  font-size: 11px;\n  color: var(--fg-1);\n  overflow: hidden;\n}\n\n.status-path {\n  font-family: var(--mono);\n  max-width: 40ch;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  color: var(--fg-2);\n}\n\n.status-item {\n  display: flex;\n  gap: 4px;\n  align-items: center;\n  max-width: 28ch;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.status-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  border: none;\n  background: transparent;\n  color: var(--fg-1);\n  padding: 1px 4px;\n  border-radius: 4px;\n  font-size: 11px;\n}\n\n.status-btn:hover {\n  background: var(--bg-3);\n  color: var(--fg-0);\n}\n"\n  }\n}\n</action>\n</action>
