value={delegationGoal}\n            placeholder=\"Goal for the external agent CLI\"\n            onChange={(e) => setDelegationGoal(e.target.value)}\n            aria-label=\"Delegation goal\"\n          />\n          <button\n            type=\"button\"\n            className=\"btn btn-ghost\"\n            disabled={delegationGoal.trim().length === 0 || state.delegation?.state === 'running'}\n            onClick={() => {\n              void actions.launchDelegation(delegationGoal.trim());\n              setDelegationGoal('');\n            }}\n          >\n            Launch\n          </button>\n        </div>\n      </div>\n    </aside>\n  );\n}\n"\n  }\n}\n</action>
