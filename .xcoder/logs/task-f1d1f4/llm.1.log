ction\": {\r\n                \"name\": name,\r\n                \"description\": description,\r\n                \"parameters\": {\r\n                    \"type\": \"object\",\r\n                    \"properties\": {\"task\": {\"type\": \"string\"}},\r\n                    \"required\": [\"task\"],\r\n                    \"additionalProperties\": False,\r\n                },\r\n            },\r\n        }\r\n        for name, description in (\r\n            (\"run_litebro\", \"Plan and execute a general work request in the current workspace.\"),\r\n            (\"run_bugfinder\", \"Run functional QA and regression testing in the current workspace.\"),\r\n        )\r\n    ),\r\n)\r\nMAX_MEMORY_CHARS = 24000\r\nMAX_SUMMARY_CHARS = 4000\r\n\r\n\r\nclass StatusIcon(QLabel):\r\n    \"\"\"Compact status display that retains the full message for hover and accessibility.\"\"\"\r","totalLines":851,"sliced":true},{"label":"--- xcoder-ai-dojo/xcoder_ai_dojo/runners.py (lines 1-55 of 517) ---","content":"\"\"\"Resolve run targets from source files and project manifests.\"\"\"\r\n\r\nimport csv\r\nimport json\r\nimport os\r\nimport re\r\nimport shutil\r\nimport sqlite3\r\nimport stat\r\nimport subprocess\r\nimport sys\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\n\r\nPYTHON = {\".py\", \".pyw\"}\r\nJAVASCRIPT = {\".js\", \".mjs\", \".cjs\", \".jsx\"}\r\nTYPESCRIPT = {\".ts\", \".mts\", \".cts\", \".tsx\"}\r\nJAVA = {\".java\"}\r\nVUE = {\".vue\"}\r\nPOWERSHELL = {\".ps1\"}\r\nBASH = {\".sh\", \".bash\"}\r\nBATCH = {\".cmd\", \".bat\"}\r\nSHELL = POWERSHELL | BASH | BATCH\r\nSQL = {\".sql\"}\r\nWEB = JAVASCRIPT | TYPESCRIPT | VUE\r\nSOURCE_SUFFIXES = PYTHON | WEB | JAVA | SHELL | SQL\r\nJSX = {\".jsx\", \".tsx\"}\r\nFRONTEND_PACKAGES = {\"react\", \"react-dom\", \"next\", \"react-scripts\", \"vue\", \"nuxt\", \"@vue/cli-service\"}\r\nJAVA_MANIFESTS = (\"pom.xml\", \"build.gradle\", \"build.gradle.kts\")\r\nPROJECT_FILES = {\"package.json\", *JAVA_MANIFESTS, \"__main__.py\", \"main.py\", \"app.py\"}\r\nSKIP_PROJECT_DIRS =
[2026-11-16T09:19:30.851Z] [design-st-2c7624] [stop=end_turn] [response] {\n  "thought": "I have the reference layout, module map, and the requirements doc's constraints/ACs. No xcoder-dojo/ exists yet, so this is a greenfield design. Now I write the design document to .xcoder/backlog/design-st-2c7624.md in two appends: shared contracts + shell + first pages, then the remaining pages, tradeoffs, and traceability.",\n  "action": {\n    "tool": "write_file",\n    "input": {\n      "path": ".xcoder/backlog/design-st-2c7624.md",\n      "content": "# Design: xcoder-dojo — UI / Page Specification (TypeScript UI + Agent)\n\n- Task: design-st-2c7624 (stage: design, role: business-analyst)\n- Upstream: `.xcoder/backlog/requirements-st-b1522d.md` (requirements, 21 ACs, 12 security constraints S-01..S-13)\n- Reference (read-only input): `xcoder-ai-dojo/` (PyQt6, v0.1.4) — blueprint §3 \"User experience\" and §4 module map\n- Target: new sibling folder `xcoder-dojo/` (greenfield; no TS scaffold exists in this workspace)\n- Scope of this document: navigation flows, page/subpage specs, per-page data requirements, display modes, UI event/action contracts, component interfaces, and the UX-vs-simplicity tradeoffs taken.\n- Not in this document: module/file layout, build pipeline, process supervisor internals, LLM wire format (covered by architecture/implementation stages). Where a decision would change a page contract, it is flagged inline.\n\n---\n\n## 1. What \"components\" and \"interfaces\" mean here\n\n- **Component (page/subpage):** a user-visible, independently stateable surface with its own data requirements and action set. Pages are the unit of specification, not React components. Every page below has an ID (`P-xx`) and at least one TypeScript interface describing its view-model and its action surface.\n- **Interface / contract:** (a) the **page model** — the exact data a page renders, with nullability and provenance; (b) the **action contract** — name, input, preconditions, side-effect class, approval requirement, and the process that enforces it; (c) the **IPC bridge** — the only channel from page to privileged work.\n- **Tradeoff:** every place where a richer UX was rejected for a simpler, enforceable contract (or the reverse), with the cost stated.\n\nTwo invariants apply to every page and are not repeated per page:\n\n1. **UI checks are UX only** [UI-01]. Every action's authorization/validation is re-enforced in the Electron main process. A page that hides a button is not a control.\n2. **All model-derived and file-derived text is untrusted** [UI-02/UI-03/UI-13, PRM-01]. It renders as escaped text or sanitized Markdown; no raw HTML, no `dangerouslySetInnerHTML`, no remote images, no script execution, and it is labelled as AI-generated or workspace-derived.\n\n---\n\n## 2. Navigation flow\n\n### 2.1 Page hierarchy\n\n```\nP-00 App Shell (persistent frame — title bar, left rail, center, right dock, bottom dock, status bar)\n├─ P-01 Welcome / No-Workspace            (center, replaces P-03 while no workspace)\n├─ P-02 Workspace Explorer                (left dock, lazy tree + filter)\n│    └─ P-02a Node Context Menu           (subpage / transient overlay)\n├─ P-03 Editor Area                       (center, tabbed)\n│    ├─ P-03a Text Editor Pane            (CodeMirror 6; highlighting, line numbers, gutter)\n│    ├─ P-03b Markdown Preview Pane       (split beside P-03a when tab kind = markdown)\n│    └─ P-03c Unopenable File State       (binary / non-UTF-8 / too large / outside root)\n├─ P-04 Run Console                       (bottom dock, single-flight)\n│    └─ P-04a Run Target Picker           (subpage: resolved file/project targets)\n├─ P-05 Agent Panel — JARVIS              (right dock)\n│    ├─ P-05a Tool Call Card              (inline list item)\n│    ├─ P-05b Turn-Limit Banner           (inline terminal state)\n│    └─ P-05c Model-Not-Configured State  (inline empty state)\n├─ P-06 Delegation Run View               (right dock takeover from P-05)\n├─ P-07 Approval Sheet                    (modal overlay; file-write | delegation-launch)\n├─ P-08 Settings                          (modal page, tabbed)\n│    ├─ P-08a Model & Limits\n│    ├─ P-08b Data, Secrets & Audit\n│    └─ P-08c Appearance\n├─ P-09 Conversation History              (drawer inside P-05)\n├─ P-10 Audit Log Viewer                  (modal, cursor-paginated)\n└─ P-12 Error Center                      (toast stack + detail sheet)\n\nPersistent chrome (present on all pages):\n- P-11 Status Bar  (workspace path, run state, agent state, audit-log location link, model state)\n```\n\n### 2.2 Transitions\n\n| From | Trigger | To | Guard / failure |\n| --- | --- | --- | --- |\n| P-01 | `workspace.open` (dialog or drop a folder) | P-00 + P-02 populated | Outside-root or unreadable folder → P-12 error, stay on P-01 |\n| P-01 | `workspace.open` refused (path is a file) | P-12 | Explicit \"select a folder\" message |\n| P-02 | `file.open` (double-click / Enter on file) | P-03 new tab | Unopenable → P-03c tab with error state; never a blank editor |\n| P-02 | Right-click a node | P-02a | — |\n| P-03 | Ctrl+S / `file.save` | P-03 (dirty cleared) | Write failure → P-12 error + tab stays dirty |\n| P-03 | Tab kind = markdown | P-03b opens in split | Remote images/HTML blocked inline in preview |\n| P-03 | Ctrl+R / `run.start` | P-04 | Console busy → P-04 report, no second process |\n| P-04 | `run.start` with no resolvable target | P-04a | No target → explicit \"no run target\" error, not a silent no-op |\n| P-05 | user sends a message | P-05 streaming answer + P-05a cards | No model configured → P-05c; app stays usable |\n| P-05a | model emits a delegation tool call | P-07 (`delegation-launch`) | Denied → card shows `denied`, delegation never starts |\n| P-07 approved (delegation) | — | P-06 | CLI missing → P-06 `failed-cli-missing` + remediation |\n| P-07 approved (file-write) | — | back to originating page | Target file changed since approval → approval expires, re-prompt |\n| P-05 | `session.clear` | P-05 empty transcript | — |\n| P-11 | click audit-log location | P-10 | Log missing → P-12 with path shown |\n| Any | unrecoverable main-process error | P-12 | Never a blank white renderer; shell renders the error page |\n\nNavigation rules: one workspace at a time (per window); one active run at a time; one active agent request at a time; opening a second workspace requires closing the current one (unsaved-tab prompt first). This mirrors the reference's single-flight console and per-workspace agent busy state.\n\n---\n\n## 3. Shared contracts (referenced by every page)\n\n```ts\n// src/shared/contracts/ids.ts\nexport type PageId =\n  | 'shell' | 'welcome' | 'explorer' | 'editor' | 'preview' | 'console'\n  | 'agent' | 'delegation' | 'approval' | 'settings' | 'history' | 'audit' | 'status';\nexport type SupportedLanguage =\n  | 'typescript' | 'javascript' | 'json' | 'markdown' | 'python' | 'html'\n  | 'css' | 'shell' | 'powershell' | 'yaml' | 'sql' | 'plaintext';\n\n// src/shared/contracts/errors.ts — the ONLY error shape a page renders.\nexport interface AppError {\n  code: AppErrorCode;          // enumerated, never a raw stack or provider string\n  message: string;             // user-facing, pre-redacted in main\n  remediation?: string;        // e.g. \"Install Node.js, or pick another run target\"\n  detailRef?: string;          // opaque id -> full detail in P-10, not in the toast\n}\nexport type AppErrorCode =\n  | 'workspace-not-open' | 'path-escape' | 'credential-file' | 'excluded-dir'\n  | 'binary-file' | 'not-utf8' | 'file-too-large' | 'write-failed' | 'run-busy'\n  | 'run-spawn-failed' | 'runtime-missing' | 'model-not-configured' | 'model-error'\n  | 'schema-invalid' | 'tool-not-allowlisted' | 'turn-limit' | 'request-cap-reached'\n  | 'delegation-cli-missing' | 'workspace-changed' | 'approval-expired'\n  | 'secret-detected' | 'unknown';\n\n// src/shared/contracts/action.ts — the action contract shared by pages and main.\nexport type SideEffect = 'none' | 'read' | 'write' | 'execute' | 'secret';\nexport interface ActionDescriptor<In, Out> {\n  readonly name: ActionName;\n  readonly page: PageId;\n  readonly sideEffect: SideEffect;\n  readonly requiresApproval: boolean; // true => P-07 must interpose\n  readonly enforcedIn: 'main';        // never 'renderer' — see [UI-01]\n  validate(input: unknown): In;       // throws AppError('schema-invalid')\n  run(input: In): Promise<Out>;\n}\nexport type ActionName =\n  | 'workspace.open' | 'workspace.close'\n  | 'tree.listChildren' | 'tree.revealPath' | 'tree.filter'\n  | 'file.open' | 'file.save' | 'file.saveAll' | 'file.close' | 'file.revert'\n  | 'run.resolveTargets' | 'run.start' | 'run.stop' | 'run.clearConsole'\n  | 'agent.send' | 'agent.stop' | 'agent.retryLast'\n  | 'session.list' | 'session.load' | 'session.clear'\n  | 'delegation.launch' | 'delegation.stop'\n  | 'approval.list' | 'approval.respond'\n  | 'settings.get' | 'settings.update' | 'settings.setApiKey' | 'settings.clearApiKey'\n  | 'audit.page' | 'audit.location';\n```\n\n```ts\n// src/shared/contracts/bridge.ts — the whole privileged surface. Nothing else is exposed.\nexport interface DojoBridge {\n  workspace: {\n    openDialog(): Promise<WorkspaceOpened>;              // user gesture in main; renderer never supplies a raw path\n    openPath(relOrAbs: string): Promise<WorkspaceOpened>; // validated in main, resolved + root-confined\n    close(): Promise<void>;\n    current(): Promise<WorkspaceOpened | null>;\n  };\n  tree: {\n    listChildren(request: ListChildrenRequest): Promise<TreeNodePage>;\n  };\n  files: {\n    read(relPath: string): Promise<FileReadResult>;      // result carries encoding/eol/kind or an AppError\n    save(request: SaveRequest): Promise<SaveResult>;      // requires approval if agent-initiated\n  };\n  run: {\n    resolveTargets(relPath: string): Promise<RunTarget[]>;\n    start(request: RunStartRequest): Promise<RunSession>;\n    stop(runId: string): Promise<RunSession>;\n    onEvent(handler: (event: RunEvent) => void): Unsubscribe;\n  };\n  agent: {\n    send(request: AgentSendRequest): Promise<{ requestId: string }>;\n    stop(requestId: string): Promise<void>;\n    onEvent(handler: (event: AgentEvent) => void): Unsubscribe;\n  };\n  session: {\n    list(): Promise<SessionSummary[]>;\n    load(sessionId: string): Promise<SessionDetail>;\n    clear(sessionId: string): Promise<void>;\n  };\n  delegation: {\n    launch(request: DelegationLaunchRequest): Promise<DelegationRun>;\n    stop(delegationId: string): Promise<DelegationRun>;\n    onEvent(handler: (event: DelegationEvent) => void): Unsubscribe;\n  };\n  approval: {\n    list(): Promise<ApprovalRequest[]>;\n    respond(decision: { approvalId: string; decision: ApprovalDecision }): Promise<ApprovalRequest>;\n    onRequest(handler: (request: ApprovalRequest) => void): Unsubscribe;\n  };\n  settings: {\n    get(): Promise<LlmSettingsView>;\n    update(patch: LlmSettingsPatch): Promise<LlmSettingsView>;\n    setApiKey(input: ApiKeyInput): Promise<LlmSettingsView>;  // write-only; never echoed back\n    clearApiKey(): Promise<LlmSettingsView>;\n  };\n  audit: {\n    page(request: AuditPageRequest): Promise<AuditPage>;\n    location(): Promise<{ logDir: string; retentionDays: number }>;\n  };\n  errors: {\n    onError(handler: (error: AppError) => void): Unsubscribe;\n  };\n}\nexport type Unsubscribe = () => void;\n```\n\nBridge rules (enforced in `preload`, not by convention): no `ipcRenderer` exposure; channels are an explicit allowlist; every payload is schema-validated in main before use; every response is a discriminated `{ ok: true, value } | { ok: false, error: AppError }`; the API key is **never** returnable — only `[REDACTED] [UI-07, S-02, AI-06].\n\n---\n\n## 4. P-00 App Shell\n\n**Purpose:** the persistent frame that makes workspace and command context explicit (a stated product principle). It is not a route; it owns layout and chrome.\n\n**Regions:** title bar (app name `Xcoder Dojo`, active workspace absolute path, dirty-tab count) · left dock (P-02) · center (P-01 or P-03) · right dock (P-05 or P-06) · bottom dock (P-04) · status bar (P-11) · overlay slot (P-07, P-08, P-10, P-12).\n\n**Data requirements**\n\n| Field | Source | Type | Notes |\n| --- | --- | --- | --- |\n| appVersion | main (`app.getVersion`) | string | shown in P-08c |\n| workspaceId | `workspace.current` | string \\| null | null → P-01 |\n| workspacePathDisplay | main, path-normalized | string \\| null | absolute, always visible |\n| openTabCount / dirtyCount | editor store | number | drives close/save prompt |\n| rightDockMode | UI state | `'agent' \\| 'delegation' \\| 'collapsed'` | — |\n| bottomDockMode | UI state | `'console' \\| 'collapsed'` | — |\n| dockSizes | persisted UI state | `Record<DockId, number>` | restored on start |\n| modelState | `settings.get` | `'configured' \\| 'missing' \\| 'error'` | surface in P-11 |\n\n**Interface**\n\n```ts\nexport interface ShellModel {\n  appVersion: string;\n  workspace: { workspaceId: string; pathDisplay: string; name: string } | null;\n  openTabCount: number;\n  dirtyCount: number;\n  rightDock: { mode: 'agent' | 'delegation' | 'collapsed'; width: number };\n  bottomDock: { mode: 'console' | 'collapsed'; height: number };\n  modelState: 'configured' | 'missing' | 'error';\n}\nexport interface ShellActions {\n  openWorkspace(): Promise<void>;      // -> workspace.open\n  closeWorkspace(): Promise<void>;     // -> workspace.close (unsaved prompt first)\n  toggleDock(dock: 'right' | 'bottom'): void;\n  focusEditor(): void;\n  openSettings(): void;\n  openAuditLog(): void;\n}\n```\n\n**Display modes:** view (chrome), no list/detail. **States:** loading (skeleton docks, workspace resolving), ready, degraded (model missing → banner, not a modal), fatal (renderer failed → P-12 shell error page).\n\n---\n\n## 5. P-01 Welcome / No-Workspace\n\n**Purpose:** the only page reachable with `workspaceId === null`. Must never look like a broken editor.\n\n**Data requirements**\n\n| Field | Source | Type |\n| --- | --- | --- |\n| recentWorkspaces | main store (paths only, no file contents) | `RecentWorkspace[]` (max 10, `{ pathDisplay, lastOpenedAtMs }`) |\n| modelState + provider/model label | `settings.get` | `LlmSettingsView` |\n| startableHint | derived | string (\"Open a folder to begin\") |\n\n**Interface**\n\n```ts\nexport interface WelcomeModel {\n  recentWorkspaces: ReadonlyArray<{ pathDisplay: string; lastOpenedAtMs: number }>;\n  modelState: 'configured' | 'missing' | 'error';\n  modelLabel: string | null;   // e.g. \"gpt-x @ openai-compatible\" — never a key or full URL with creds\n}\nexport interface WelcomeActions {\n  chooseFolder(): Promise<void>;                 // -> workspace.open (OS dialog only)\n  openRecent(pathDisplay: string): Promise<void>; // main re-validates; stale entry -> P-12 + remove from list\n  openSettings(): void;\n}\n```\n\n**Display modes:** list (recent, sortable by recency, max 10, not paginated), view. **Empty state:** no recents → the choose-folder CTA with a one-line explanation. **Guards:** no path is ever typed by the user into this page (a free-text path field would create an unvalidated path input surface).\n\n---\n\n## 6. P-02 Workspace Explorer\n\n**Purpose:** lazy file tree confined to the opened workspace root; the discovery surface for every file action.\n\n**Data requirements**\n\n| Field | Source | Type | Notes |\n| --- | --- | --- | --- |\n| children of a dir | `tree.listChildren` | `FileNode[]` | one directory per call; never a whole-tree walk |\n| relPath | main | string | POSIX separators, always root-relative |\n| kind | main | `'file' \\| 'dir'` | — |\n| hasChildren | main | boolean | drives the expand chevron without a second call |\n| language | main (extension map) | `SupportedLanguage` | drives the language chip, not the save path |\n| sizeBytes / mtimeMs | main stat | number | sortable columns |\n| truncated / scannedFiles | main | boolean / number | exposes the 1500-file scan bound honestly |\n| excludedReason | main | `'hidden' \\| 'generated' \\| 'credential' \\| null` | excluded nodes are **not listed**; the reason is used only in refusal messages |\n\n```ts\nexport interface FileNode {\n  nodeId: string;            // stable: hash of relPath\n  relPath: string;\n  name: string;\n  kind: 'file' | 'dir';\n  hasChildren: boolean;\n  language?: SupportedLanguage;\n  sizeBytes?: number;\n  mtimeMs?: number;\n}\nexport interface ListChildrenRequest { parentRelPath: string | null; cursor?: string; limit?: number; }\nexport interface TreeNodePage {\n  parentRelPath: string | null;\n  entries: FileNode[];\n  nextCursor: string | null;   // null => no more\n  truncated: boolean;          // true => hit file/scan bound\n  scannedFiles: number;        // vs. configured 1500 cap\n}\nexport interface ExplorerModel {\n  workspaceRootLabel: string;\n  expandedRelPaths: ReadonlyArray<string>;\n  nodesByParent: Readonly<Record<string, TreeNodePage>>;\n  selection: { relPath: string; kind: 'file' | 'dir' } | null;\n  filter: { text: string; applied: boolean };   // filters loaded children only — see T-05\n  loadingParents: ReadonlyArray<string>;\n}\nexport interface ExplorerActions {\n  expand(relPath: string): Promise<void>;              // tree.listChildren\n  collapse(relPath: string): void;\n  refresh(relPath: string): Promise<void>;\n  openFile(relPath: string): Promise<void>;            // file.open -> P-03\n  revealInExplorer(relPath: string): Promise<void>;    // OS reveal; workspace-confined\n  copyRelativePath(relPath: string): Promise<void>;    // clipboard only, never a secret path\n  filter(text: string): void;\n}\n```\n\n**Display modes:** list (hierarchical, virtualized), sortable (name, size, mtime — client-side on loaded nodes), searchable (filter on loaded nodes), paginated/lazy (per-directory `nextCursor`). **States:** loading (per-node spinner, tree stays interactive), empty dir, truncated dir (inline \"showing first N of M\" with the bound named), error (per-node retry, not a whole-tree failure), workspace-changed (stale nodes → banner + refresh action).\n**Security:** absolute paths, `..`, dotfiles, generated dirs and credential-shaped names never appear and any attempt to request them returns `AppError('path-escape' | 'credential-file' | 'excluded-dir')` from main [S-06]. The tree is a projection of a server-side decision, not a client-side filter.\n\n---\n\n## 7. P-03 Editor Area (with P-03a / P-03b / P-03c)\n\n**Purpose:** tabbed editing with highlighting, line numbers, encoding/EOL fidelity, and a Markdown split preview.\n\n**Data requirements**\n\n| Field | Source | Type | Notes |\n| --- | --- | --- | --- |\n| tabs | renderer store, hydrated from `files.read` | `EditorTabState[]` | order = open order, MRU on re-open |\n| encoding | main (BOM sniff) | `'utf-8' \\| 'utf-8-bom'` | preserved on save, never silently normalized |\n| eol | main (first-line detect) | `'lf' \\| 'crlf'` | preserved on save |\n| dirty | renderer (buffer vs. saved sha) | boolean | drives close prompt + tab dot |\n| language | main | `SupportedLanguage` | CodeMirror mode |\n| content | `files.read` | string | capped; `truncated` flag when the read bound applies |\n| errorCode | main | `FileOpenErrorCode` | P-03c only |\n| savedAtMs / savedSha | main | number / string | optimistic-concurrency token for save |\n\n```ts\nexport type FileOpenErrorCode =\n  | 'binary-file' | 'not-utf8' | 'file-too-large' | 'outside-workspace' | 'denied-credential' | 'missing';\nexport interface EditorTabState {\n  tabId: string;\n  relPath: string;\n  kind: 'text' | 'markdown' | 'error';\n  language: SupportedLanguage;\n  encoding: 'utf-8' | 'utf-8-bom';\n  eol: 'lf' | 'crlf';\n  dirty: boolean;\n  readOnly: boolean;\n  truncated: boolean;\n  errorCode?: FileOpenErrorCode;\n  savedSha: string | null;\n}\nexport interface FileReadResult {\n  relPath: string; content: string; encoding: 'utf-8' | 'utf-8-bom'; eol: 'lf' | 'crlf';\n  language: SupportedLanguage; sizeBytes: number; truncated: boolean; savedSha: string;\n}\nexport interface SaveRequest { tabId: string; relPath: string; content: string; baseSha: string; writeNewFile: boolean; }\nexport interface SaveResult { ok: boolean; relPath: string; bytesWritten: number; encoding: 'utf-8' | 'utf-8-bom'; eol: 'lf' | 'crlf'; savedSha: string; savedAtMs: number; error?: AppError; }\nexport interface EditorModel {\n  tabs: ReadonlyArray<EditorTabState>;\n  activeTabId: string | null;\n  splitPreview: { open: boolean; tabId: string | null };\n  saveInFlight: ReadonlyArray<string>;   // tabIds\n}\nexport interface EditorActions {\n  open(relPath: string): Promise<void>;         // file.open\n  activate(tabId: string): void;\n  close(tabId: string): Promise<void>;          // dirty -> save/discard prompt\n  save(tabId: string): Promise<SaveResult>;     // file.save\n  saveAll(): Promise<ReadonlyArray<SaveResult>>;\n  revert(tabId: string): Promise<void>;         // file.revert (discards buffer)\n  togglePreview(tabId: string): void;           // markdown only\n  find(text: string): void;                     // CodeMirror search, no IPC\n}\n```\n\n**Display modes:** editable (content), view (tab strip, gutter), detail (per-tab metadata in the status strip: language, encoding, EOL, dirty). No pagination — one buffer is loaded whole, or the tab is P-03c.\n\n**P-03a Text Editor Pane:** CodeMirror 6; syntax highlighting + line numbers for the `language` set; find/replace in-editor; no remote resource loading; no HTML rendering of file content (always text).\n**P-03b Markdown Preview Pane:** debounced render of sanitized Markdown; **local images only** resolved through a root-confined file URL; embedded raw HTML and remote images are skipped and the skip is annotated inline (a \"1 remote image blocked\" note) so the omission is visible, not silent.\n**P-03c Unopenable File State:** renders the specific `errorCode` with remediation (\"This file is not UTF-8 text. It was not opened, and nothing was modified.\"), keeps the tab closable, and never shows a partial/garbled buffer [AC-05].\n**States:** clean, dirty, saving (input stays live, save is idempotent by `baseSha`), conflict (`baseSha` mismatch → \"file changed on disk\", offer reload/diff/overwrite-with-approval), read-only (outside write permission or newly denied path).\n**Security:** file content is rendered as text, never HTML [UI-02/UI-03]; save is `sideEffect: 'write'` and passes through P-07 when the write was agent-initiated [S-07]; no path may resolve outside root.\n\n---\n\n## 8. P-04 Run Console (with P-04a Run Target Picker)\n\n**Purpose:** the single execution surface — resolve a runnable target, execute it, stream stdout/stderr, show the exit code, and let the user stop it.\n\n**Data requirements**\n\n| Field | Source | Type | Notes |\n| --- | --- | --- | --- |\n| resolved targets | `run.resolveTargets` | `RunTarget[]` | file kind, package script, or project manifest — mirrors the reference runtime matrix |\n| argv | main | `string[]` | **argv array, never a shell string** [S-08, PRM-08] |\n| cwdRelPath | main | string | always inside the workspace |\n| state | main events | `RunState` | `idle→starting→running→stopping→exited \\| failed` |\n| chunks | `run.onEvent` | `ConsoleChunk[]` | ring buffer with per-run cap |\n| exitCode / signal | main | `number \\| null` / `string?` | surfaced explicitly, including non-zero [AC-06/AC-08] |\n| truncated | main | `{stdout,stderr}` | reports when the output cap was hit [AC-19] |\n\n```ts\nexport type RunState = 'idle' | 'starting' | 'running' | 'stopping' | 'exited' | 'failed';\nexport interface CommandSpec { argv: ReadonlyArray<string>; cwdRelPath: string; envKeys: ReadonlyArray<string>; }\nexport interface RunTarget {\n  targetId: string; label: string; kind: 'file' | 'script' | 'project';\n  relPath: string; command: CommandSpec;\n  source: 'file-extension' | 'package-script' | 'project-manifest' | 'user-override';\n  requiresRuntime: string | null;   // \"node\" | \"python\" | \"pwsh\" — surfaced before start\n}\nexport interface ConsoleChunk { runId: string; seq: number; stream: 'stdout' | 'stderr' | 'system'; text: string; atMs: number; }\nexport interface RunSession {\n  runId: string; targetId: string; state: RunState; startedAtMs: number;\n  exitCode: number | null; signal?: string; truncated: { stdout: boolean; stderr: boolean };\n}\nexport interface ConsoleModel {\n  session: RunSession | null;\n  chunks: ReadonlyArray<ConsoleChunk>;   // capped, oldest dropped first\n  targets: ReadonlyArray<RunTarget>;\n  selectedTargetId: string | null;\n  pendingTargetFor: string | null;       // relPath awaiting picker choice\n}\nexport interface ConsoleActions {\n  resolveTargets(relPath: string): Promise<ReadonlyArray<RunTarget>>;  // run.resolveTargets\n  start(targetId: string): Promise<RunSession>;                        // run.start\n  stop(): Promise<RunSession>;                                        // run.stop\n  clearConsole(): void;                                               // run.clearConsole (client-side)\n  copyOutput(): Promise<void>;                                        // redacted text only\n}\n```\n\n**Display modes:** view + append-only stream; list (chunks, virtualized, filterable by stream via the stderr/stdout toggle); sortable N/A (time-ordered, immutable); searchable (in-console find over buffered text); paginated (ring-buffer windowing, not server paging).\n**States:** idle, starting, running, stopping (Stop acknowledged, awaiting exit), exited-with-0, exited-non-zero (explicit bar: \"exit code 1\"), failed-to-spawn (`runtime-missing` → remediation naming the runtime), busy (`run-busy` when a run is active — single-flight, no queue), truncated output (explicit note).\n**Security:** no shell interpolation; Stop is a real terminate with a timeout escalation; env is an allowlist of keys, not the full parent environment; copy-output passes through the redactor [S-08, S-11].\n**AC coverage:** AC-06 (streams stdout+stderr, exit code), AC-07 (single-flight + Stop reported), AC-08 (missing runtime / non-zero exit explicit), AC-19 (cap + reported truncation).\n\n<!-- SECTION-B -->\n"\n    }\n  }\n}
