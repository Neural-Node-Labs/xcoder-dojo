background: var(--bg-2);\n  padding: 3px 4px 3px 9px;\n  font-size: 12px;\n  color: var(--fg-1);\n  white-space: nowrap;\n}\n\n.tab-active {\n  background: var(--bg-0);\n  color: var(--fg-0);\n  border-color: var(--accent);\n  box-shadow: inset 0 2px 0 var(--accent);\n}\n\n.tab-label {\n  border: none;\n  background: transparent;\n  color: inherit;\n  font-family: var(--mono);\n  font-size: 11.5px;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n}\n\n.dirty-dot {\n  color: var(--accent-2);\n  font-size: 8px;\n}\n\n.tab-close {\n  font-size: 12px;\n}\n\n.editor-body {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n}\n\n.editor-toolbar {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 5px 10px;\n  border-bottom: 1px solid var(--line-soft);\n  background: var(--bg-1);\n}\n\n.breadcrumb {\n  font-family: var(--mono);\n  font-size: 11.5px;\n  color: var(--fg-1);\n}\n\n.editor-split {\n  flex: 1;\n  display: grid;\n  grid-template-columns: 1fr;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.editor-split.with-preview {\n  grid-template-columns: 1fr 1fr;\n}\n\n.syntax-editor {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  min-width: 0;\n}\n\n.editor-meta {\n  display: flex;\n  gap: 6px;\n  padding: 4px 10px;\n  border-bottom: 1px solid var(--line-soft);\n}\n\n.editor-pane {\n  position: relative;\n  flex: 1;\n  overflow: auto;\n  background: var(--bg-0);\n}\n\n.code-lines {\n  position: absolute;\n  inset: 0;\n  margin: 0;\n  padding: 10px 0;\n  font-family: var(--mono);\n  font-size: 12.5px;\n  line-height: 1.55;\n  pointer-events: none;\n}\n\n.code-line {\n  display: flex;\n  gap: 10px;\n  padding: 0 12px;\n  white-space: pre;\n}\n\n.gutter-num {\n  width: 3ch;\n  flex: 0 0 auto;\n  text-align: right;\n  color: var(--fg-2);\n  opacity: 0.65;\n}\n\n.code-content {\n  flex: 1;\n}\n\n.tok-keyword {\n  color: #c792ea;\n}\n\n.tok-string {\n  color: #c3e88d;\n}\n\n.tok-number {\n  color: #f78c6c;\n}\n\n.tok-comment {\n  color: var(--fg-2);\n  font-style: italic;\n}\n\n.tok-type {\n  color: #82aaff;\n}\n\n.editor-textarea {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  padding: 10px 12px 10px calc(12px + 3ch + 10px);\n  border: none;\n  border-radius: 0;\n  background: transparent;\n  color: transparent;\n  caret-color: var(--accent);\n  font-family: var(--mono);\n  font-size: 12.5px;\n  line-height: 1.55;\n  resize: none;\n  white-space: pre;\n  overflow: hidden;\n}\n\n.editor-textarea:focus {\n  border: none;\n  outline: none;\n}\n\n.editor-textarea::selection {\n  background: rgba(83, 209, 182, 0.28);\n  color: transparent;\n}\n\n.preview-pane {\n  border-left: 1px solid var(--line);\n  overflow: auto;\n  min-width: 0;\n}\n\n/* ------------------------------------------------------- P-03b markdown */\n\n.markdown-view {\n  padding: 10px 14px;\n}\n\n.md-banner {\n  font-size: 10.5px;\n  color: var(--warn);\n  border: 1px dashed rgba(229, 181, 103, 0.5);\n  border-radius: 6px;\n  padding: 4px 8px;\n  margin-bottom: 10px;\n}\n\n.md-body {\n  font-size: 13px;\n}\n\n.md-heading {\n  margin: 12px 0 6px;\n}\n\n.md-p {\n  margin: 0 0 8px;\n}\n\n.md-code {\n  background: var(--bg-2);\n  padding: 1px 5px;\n  border-radius: 4px;\n  font-size: 12px;\n}\n\n.md-pre {\n  background: var(--bg-2);\n  padding: 8px 10px;\n  border-radius: 6px;\n  overflow: auto;\n  border: 1px solid var(--line-soft);\n}\n\n.md-list {\n  margin: 0 0 8px;\n  padding-left: 20px;\n}\n\n.md-quote {\n  margin: 0 0 8px;\n  padding-left: 10px;\n  border-left: 2px solid var(--line);\n  color: var(--fg-1);\n}\n\n.md-rule {\n  border: none;\n  border-top: 1px solid var(--line-soft);\n  margin: 10px 0;\n}\n\n.md-link {\n  color: var(--accent-2);\n}\n\n.md-blocked-image {\n  display: inline-block;\n  border: 1px dashed var(--bad);\n  color: var(--bad);\n  border-radius: 4px;\n  padding: 1px 6px;\n  font-size: 11px;\n}\n"\n  }\n}\n</action>\n</action>
