[2026-11-16T09:30:57.996Z] [code-st-1de5aa] [stop=end_turn] [response] Backend typechecks clean. Now the UI layer — starting with the app state store and styles.\n\n<action>\n{\n  "tool": "write_file",\n  "input": {\n    "path": "xcoder-dojo/src/ui/app-state.tsx",\n    "content": "/**\n * The renderer-side application store.\n *\n * It holds the page models and talks to the backend only through DojoBridge.\n * Nothing here decides policy: a refused BridgeResult becomes a toast, and the\n * UI never assumes an action succeeded (UI-01).\n */\n\nimport {\n  createContext,\n  useCallback,\n  useContext,\n  useEffect,\n  useMemo,\n  useRef,\n  useState,\n  type ReactNode,\n} from 'react';\nimport type {\n  AgentModel,\n  ApprovalRequest,\n  BridgeEvent,\n  CommandSpec,\n  DelegationRun,\n  DojoBridge,\n  EditorTabState,\n  ErrorToast,\n  ExplorerModel,\n  LlmSettingsView,\n  MarkdownPreviewModel,\n  RunSession,\n  StatusBarModel,\n  ToolCallRecord,\n  TreeNodePage,\n  WorkspaceInfo,\n} from '../contracts';\n\nlet counter = 0;\nconst localId = (prefix: string): string => {\n  counter += 1;\n  return `${prefix}-${counter}`;\n};\n\nexport interface Toast extends ErrorToast {\n  remediation?: string;\n}\n\nexport interface AppState {\n  bridge: DojoBridge;\n  workspace: WorkspaceInfo | null;\n  recents: readonly { rootDisplayPath: string; label: string; lastOpenedAtMs: number }[];\n  settings: LlmSettingsView | null;\n  status: StatusBarModel | null;\n  explorer: ExplorerModel;\n  editor: { tabs: EditorTabState[]; activeTabId: string | null; buffers: Record<string, string> };\n  preview: MarkdownPreviewModel | null;\n  run: { targets: CommandSpec[]; session: RunSession | null };\n  delegation: DelegationRun | null;\n  agent: AgentModel | null;\n  approval: ApprovalRequest | null;\n  toasts: Toast[];\n  busy: boolean;\n}\n\nexport interface AppActions {\n  openWorkspace(path: string): Promise<void>;\n  closeWorkspace(): Promise<void>;\n  expandDir(parent: string | null): Promise<void>;\n  openFile(relPath: string): Promise<void>;\n  closeTab(tabId: string): Promise<void>;\n  activateTab(tabId: string): void;\n  editBuffer(tabId: string, value: string): void;\n  saveTab(tabId: string): Promise<void>;\n  togglePreview(tabId: string): void;\n  startRun(targetId: string): Promise<void>;\n  stopRun(): Promise<void>;\n  sendAgent(text: string): Promise<void>;\n  stopAgent(): Promise<void>;\n  clearAgent(): Promise<void>;\n  launchDelegation(goal: string): Promise<void>;\n  stopDelegation(): Promise<void>;\n  respondApproval(decision: 'approved' | 'denied'): Promise<void>;\n  patchSettings(patch: import('../contracts').LlmSettingsPatch): Promise<void>;\n  setApiKey(key: string): Promise<void>;\n  clearApiKey(): Promise<void>;\n  refreshAudit(): Promise<void>;\n  dismissToast(toastId: string): void;\n}\n\nconst initialExplorer: ExplorerModel = {\n  workspaceRootLabel: '',\n  nodesByParent: {},\n  expandedRelPaths: [],\n  selection: null,\n  filter: { text: '', applied: false },\n  loadingParents: [],\n};\n\nconst StateContext = createContext<AppState | null>(null);\nconst ActionsContext = createContext<AppActions | null>(null);\n\nexport function useAppState(): AppState {\n  const ctx = useContext(StateContext);\n  if (!ctx) throw new Error('useAppState must be used inside <AppProvider>');\n  return ctx;\n}\n\nexport function useAppActions(): AppActions {\n  const ctx = useContext(ActionsContext);\n  if (!ctx) throw new Error('useAppActions must be used inside <AppProvider>');\n  return ctx;\n}\n\nexport interface AppProviderProps {\n  bridge: DojoBridge;\n  children: ReactNode;\n}\n\nexport function AppProvider({ bridge, children }: AppProviderProps): JSX.Element {\n  const [workspace, setWorkspace] = useState<WorkspaceInfo | null>(null);\n  const [recents, setRecents] = useState<AppState['recents']>([]);\n  const [settings, setSettings] = useState<LlmSettingsView | null>(null);\n  const [status, setStatus] = useState<StatusBarModel | null>(null);\n  const [explorer, setExplorer] = useState<ExplorerModel>(initialExplorer);\n  const [tabs, setTabs] = useState<EditorTabState[]>([]);\n  const [activeTabId, setActiveTabId] = useState<string | null>(null);\n  const [buffers, setBuffers] = useState<Record<string, string>>({});\n  const [preview, setPreview] = useState<MarkdownPreviewModel | null>(null);\n  const [runTargets, setRunTargets] = useState<CommandSpec[]>([]);\n  const [runSession, setRunSession] = useState<RunSession | null>(null);\n  const [delegation, setDelegation] = useState<DelegationRun | null>(null);\n  const [agent, setAgent] = useState<AgentModel | null>(null);\n  const [approval, setApproval] = useState<ApprovalRequest | null>(null);\n  const [toasts, setToasts] = useState<Toast[]>([]);\n  const [busy, setBusy] = useState(false);\n  const toastSeq = useRef(0);\n\n  const pushToast = useCallback((error: import('../contracts').AppError): void => {\n    toastSeq.current += 1;\n    const toast: Toast = {\n      toastId: `toast-${toastSeq.current}`,\n      error,\n      atMs: Date.now(),\n      dismissed: false,\n      ...(error.remediation ? { remediation: error.remediation } : {}),\n    };\n    setToasts((prev) => [...prev.slice(-4), toast]);\n  }, []);\n\n  const unwrap = useCallback(\n    async <T,>(p: Promise<import('../contracts').BridgeResult<T>>): Promise<T | null> => {\n      const result = await p;\n      if (result.ok) return result.value;\n      pushToast(result.error);\n      return null;\n    },\n    [pushToast],\n  );\n\n  const refreshAgent = useCallback(async () => {\n    const model = await unwrap(bridge.agent.state());\n    if (model) setAgent(model);\n  }, [bridge, unwrap]);\n\n  const refreshStatus = useCallback(async () => {\n    const s = await unwrap(bridge.status.get());\n    if (s) setStatus(s);\n  }, [bridge, unwrap]);\n\n  const refreshSettings = useCallback(async () => {\n    const s = await unwrap(bridge.settings.get());\n    if (s) setSettings(s);\n  }, [bridge, unwrap]);\n\n  useEffect(() => {\n    void (async () => {\n      setRecents((await unwrap(bridge.workspace.recents())) ?? []);\n      setRunTargets((await unwrap(bridge.run.targets())) ?? []);\n      await refreshSettings();\n      await refreshStatus();\n    })();\n  }, [bridge, unwrap, refreshSettings, refreshStatus]);\n\n  useEffect(() => {\n    const off = bridge.subscribe((event: BridgeEvent) => {\n      switch (event.type) {\n        case 'agent':\n          void refreshAgent();\n          break;\n        case 'run':\n          if (event.event.type === 'run-started') setRunSession(event.event.session);\n          if (event.event.type === 'run-chunk') {\n            setRunSession((prev) =>\n              prev && prev.runId === event.event.runId\n                ? { ...prev, chunks: [...prev.chunks, event.event.chunk] }\n                : prev,\n            );\n          }\n          if (event.event.type === 'run-ended') {\n            setRunSession((prev) =>\n              prev && prev.runId === event.event.runId\n                ? { ...prev, state: event.event.state, exitCode: event.event.exitCode, endedAtMs: Date.now() }\n                : prev,\n            );\n            void refreshStatus();\n          }\n          break;\n        case 'delegation':\n          if (event.event.type === 'delegation-started') setDelegation(event.event.run);\n          if (event.event.type === 'delegation-chunk') {\n            setDelegation((prev) =>\n              prev && prev.runId === event.event.runId\n                ? { ...prev, chunks: [...prev.chunks, event.event.chunk] }\n                : prev,\n            );\n          }\n          if (event.event.type === 'delegation-ended') {\n            setDelegation((prev) =>\n              prev && prev.runId === event.event.runId\n                ? { ...prev, state: event.event.state, exitCode: event.event.exitCode, endedAtMs: Date.now() }\n                : prev,\n            );\n          }\n          break;\n        case 'approval-requested':\n          setApproval(event.request);\n          break;\n        case 'approval-resolved':\n          setApproval((prev) => (prev && prev.approvalId === event.approvalId ? null : prev));\n          break;\n        case 'settings-changed':\n          setSettings(event.view);\n          break;\n        case 'status-changed':\n          setStatus(event.status);\n          break;\n        case 'error':\n          pushToast(event.toast.error);\n          break;\n        default:\n          break;\n      }\n    });\n    return off;\n  }, [bridge, refreshAgent, refreshStatus, pushToast]);\n\n  const actions = useMemo<AppActions>(\n    () => ({\n      async openWorkspace(path) {\n        setBusy(true);\n        const info = await unwrap(bridge.workspace.open(path));\n        setBusy(false);\n        if (!info) return;\n        setWorkspace(info);\n        setExplorer({ ...initialExplorer, workspaceRootLabel: info.rootLabel });\n        setTabs([]);\n        setActiveTabId(null);\n        setBuffers({});\n        setPreview(null);\n        setRunSession(null);\n        setDelegation(null);\n        const root = await unwrap(bridge.tree.listChildren({ parentRelPath: null }));\n        if (root) setExplorer((prev) => ({ ...prev, nodesByParent: { ...prev.nodesByParent, '': root } }));\n        setRecents((await unwrap(bridge.workspace.recents())) ?? []);\n        await refreshAgent();\n        await refreshStatus();\n      },\n\n      async closeWorkspace() {\n        await unwrap(bridge.workspace.close());\n        setWorkspace(null);\n        setExplorer(initialExplorer);\n        setTabs([]);\n        setActiveTabId(null);\n        setPreview(null);\n        setAgent(null);\n        await refreshStatus();\n      },\n\n      async expandDir(parent) {\n        const key = parent ?? '';\n        setExplorer((prev) => ({\n          ...prev,\n          loadingParents: [...prev.loadingParents, key],\n        }));\n        const page: TreeNodePage | null = await unwrap(\n          bridge.tree.listChildren({ parentRelPath: parent }),\n        );\n        setExplorer((prev) => ({\n          ...prev,\n          nodesByParent: page ? { ...prev.nodesByParent, [key]: page } : prev.nodesByParent,\n          expandedRelPaths: parent ? [...new Set([...prev.expandedRelPaths, parent])] : prev.expandedRelPaths,\n          loadingParents: prev.loadingParents.filter((p) => p !== key),\n        }));\n      },\n\n      async openFile(relPath) {\n        const file = await unwrap(bridge.files.read(relPath));\n        if (!file) return;\n        const tabId = localId('tab');\n        const isMarkdown = file.language === 'markdown';\n        const tab: EditorTabState = {\n          tabId,\n          relPath: file.relPath,\n          kind: isMarkdown ? 'markdown' : 'text',\n          language: file.language,\n          encoding: file.encoding,\n          eol: file.eol,\n          dirty: false,\n          readOnly: file.truncated,\n          truncated: file.truncated,\n          savedSha: file.savedSha,\n        };\n        setTabs((prev) => [...prev.filter((t) => t.relPath !== relPath), tab]);\n        setActiveTabId(tabId);\n        setBuffers((prev) => ({ ...prev, [tabId]: file.content }));\n        if (isMarkdown) {\n          const model = await unwrap(bridge.files.markdown(relPath));\n          if (model) setPreview(model);\n        } else {\n          setPreview(null);\n        }\n        setExplorer((prev) => ({ ...prev, selection: { relPath, kind: 'file' } }));\n        await refreshStatus();\n      },\n\n      async closeTab(tabId) {\n        setTabs((prev) => prev.filter((t) => t.tabId !== tabId));\n        setBuffers((prev) => {\n          const next = { ...prev };\n          delete next[tabId];\n          return next;\n        });\n        setActiveTabId((prev) => (prev === tabId ? null : prev));\n      },\n\n      activateTab(tabId) {\n        setActiveTabId(tabId);\n        const tab = tabs.find((t) => t.tabId === tabId);\n        if (tab && tab.kind === 'markdown') {\n          void (async () => {\n            const model = await unwrap(bridge.files.markdown(tab.relPath));\n            if (model) setPreview(model);\n          })();\n        }\n      },\n\n      editBuffer(tabId, value) {\n        setBuffers((prev) => ({ ...prev, [tabId]: value }));\n        setTabs((prev) => prev.map((t) => (t.tabId === tabId ? { ...t, dirty: true } : t)));\n      },\n\n      async saveTab(tabId) {\n        const tab = tabs.find((t) => t.tabId === tabId);\n        if (!tab) return;\n        const content = buffers[tabId] ?? '';\n        const result = await unwrap(\n          bridge.files.save({\n            tabId,\n            relPath: tab.relPath,\n            content,\n            baseSha: tab.savedSha ?? '',\n            writeNewFile: tab.savedSha === null,\n          }),\n        );\n        if (!result) return;\n        setTabs((prev) =>\n          prev.map((t) => (t.tabId === tabId ? { ...t, dirty: false, savedSha: result.savedSha } : t)),\n        );\n        if (tab.kind === 'markdown') {\n          const model = await unwrap(bridge.files.markdown(tab.relPath));\n          if (model) setPreview(model);\n        }\n      },\n\n      togglePreview() {\n        // Split preview is driven by the markdown tab being active.\n      },\n\n      async startRun(targetId) {\n        const session = await unwrap(bridge.run.start({ targetId }));\n        if (session) setRunSession(session);\n      },\n\n      async stopRun() {\n        await unwrap(bridge.run.stop());\n      },\n\n      async sendAgent(text) {\n        const result = await unwrap(bridge.agent.send({ text, sessionId: agent?.sessionId ?? '', workspaceId: workspace?.workspaceId ?? '' }));\n        if (result) await refreshAgent();\n      },\n\n      async stopAgent() {\n        await unwrap(bridge.agent.stop());\n        await refreshAgent();\n      },\n\n      async clearAgent() {\n        await unwrap(bridge.agent.clearConversation());\n        await refreshAgent();\n      },\n\n      async launchDelegation(goal) {\n        const run = await unwrap(bridge.delegation.launch({ goal }));\n        if (run) setDelegation(run);\n      },\n\n      async stopDelegation() {\n        await unwrap(bridge.delegation.stop());\n      },\n\n      async respondApproval(decision) {\n        if (!approval) return;\n        await unwrap(bridge.approval.respond({ approvalId: approval.approvalId, decision }));\n        setApproval(null);\n      },\n\n      async patchSettings(patch) {\n        const view = await unwrap(bridge.settings.patch(patch));\n        if (view) setSettings(view);\n      },\n\n      async setApiKey(key) {\n        const state = await unwrap(bridge.settings.setApiKey({ apiKey: key }));\n        if (state) await refreshSettings();\n      },\n\n      async clearApiKey() {\n        await unwrap(bridge.settings.clearApiKey());\n        await refreshSettings();\n      },\n\n      async refreshAudit() {\n        await unwrap(bridge.audit.page({ limit: 50 }));\n      },\n\n      dismissToast(toastId) {\n        setToasts((prev) => prev.filter((t) => t.toastId !== toastId));\n      },\n    }),\n    [bridge, unwrap, refreshAgent, refreshSettings, refreshStatus, tabs, buffers, agent, workspace, approval],\n  );\n\n  const state: AppState = {\n    bridge,\n    workspace,\n    recents,\n    settings,\n    status,\n    explorer,\n    editor: { tabs, activeTabId, buffers },\n    preview,\n    run: { targets: runTargets, session: runSession },\n    delegation,\n    agent,\n    approval,\n    toasts,\n    busy,\n  };\n\n  return (\n    <StateContext.Provider value={state}>\n      <ActionsContext.Provider value={actions}>{children}</ActionsContext.Provider>\n    </StateContext.Provider>\n  );\n}\n\nexport type { ToolCallRecord };\n"\n  }\n}\n</action>
