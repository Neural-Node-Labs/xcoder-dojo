);\n}\n\n.chip-ok {\n  border-color: var(--ok);\n  color: var(--ok);\n}\n\n.chip-bad {\n  border-color: var(--bad);\n  color: var(--bad);\n}\n\n.chip-warn {\n  border-color: var(--warn);\n  color: var(--warn);\n}\n\n.chip-busy {\n  border-color: var(--busy);\n  color: var(--busy);\n}\n\n.chip-dirty {\n  border-color: var(--accent-2);\n  color: var(--accent-2);\n}\n\n.chip-ai {\n  border-color: var(--accent-2);\n  color: var(--accent-2);\n}\n\n.chip-workspace {\n  border-color: var(--warn);\n  color: var(--warn);\n}\n\n.badge {\n  display: inline-block;\n  padding: 1px 7px;\n  border-radius: 999px;\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  border: 1px solid var(--line);\n  background: var(--bg-2);\n  color: var(--fg-1);\n  white-space: nowrap;\n}\n\n.badge-ok {\n  color: var(--ok);\n  border-color: rgba(63, 191, 127, 0.5);\n}\n\n.badge-bad {\n  color: var(--bad);\n  border-color: rgba(239, 107, 115, 0.5);\n}\n\n.badge-busy {\n  color: var(--busy);\n  border-color: rgba(106, 168, 255, 0.5);\n}\n\n.badge-idle {\n  color: var(--fg-2);\n}\n\n.banner {\n  padding: 6px 10px;\n  border-radius: 6px;\n  border: 1px solid var(--line);\n  background: var(--bg-2);\n  font-size: 11.5px;\n  margin: 6px 0;\n}\n\n.banner-warn {\n  border-color: rgba(229, 181, 103, 0.55);\n  background: rgba(229, 181, 103, 0.1);\n  color: var(--warn);\n}\n\n.banner-info {\n  border-color: rgba(106, 168, 255, 0.5);\n  background: rgba(106, 168, 255, 0.1);\n  color: var(--busy);\n}\n\ninput[type='text'],\ninput[type='password'],\ninput[type='number'],\nselect,\ntextarea {\n  background: var(--bg-1);\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  padding: 5px 8px;\n  outline: none;\n}\n\ninput:focus,\nselect:focus,\ntextarea:focus {\n  border-color: var(--accent);\n}\n\n.empty-state {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  height: 100%;\n  padding: 24px;\n  text-align: center;\n}\n\n.empty-state.inline {\n  height: auto;\n  padding: 14px;\n  align-items: flex-start;\n  text-align: left;\n}\n\n.empty-glyph {\n  font-family: var(--mono);\n  font-size: 26px;\n  color: var(--fg-2);\n}\n"\n  }\n}\n</action>\n</action>
