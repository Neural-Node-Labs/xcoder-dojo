"xcoder-ai-dojo/xcoder_ai_dojo/jarvis.py","xcoder-ai-dojo/xcoder_ai_dojo/main.py","xcoder-ai-dojo/xcoder_ai_dojo/markdown_preview.py","xcoder-ai-dojo/xcoder_ai_dojo/preferences.py","xcoder-ai-dojo/xcoder_ai_dojo/runners.py","xcoder-ai-dojo/xcoder_ai_dojo/sdlc_tool.py","xcoder-ai-dojo/xcoder_ai_dojo/speech_worker.py","xcoder-ai-dojo/xcoder_ai_dojo/theme.py","xcoder-ai-dojo/xcoder_ai_dojo/tool_commands.py","xcoder-ai-dojo/xcoder_ai_dojo/tool_panels.py","xcoder-ai-dojo/xcoder_ai_dojo/tts_worker.py","xcoder-ai-dojo/xcoder_ai_dojo/VERSION","xcoder-ai-dojo/xcoder_ai_dojo/voice.py","xcoder-ai-dojo/xcoder_ai_dojo/voice_input.py","xcoder-ai-dojo/xcoder_ai_dojo/voice_options.py","xcoder-ai-dojo/xcoder_ai_dojo/voice_settings.py","xcoder-ai-dojo/xcoder_ai_dojo/workspace-background.png","xcoder-ai-dojo/xcoder_ai_dojo/workspace_tools.py","xcoder-ai-dojo/xcoder_ai_dojo/__init__.py","xcoder-ai-dojo/xcoder_ai_dojo/__main__.py"]}
