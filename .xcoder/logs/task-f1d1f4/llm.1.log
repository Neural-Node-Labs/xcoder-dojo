[2026-11-16T09:33:15.591Z] [code-st-1de5aa] [stop=end_turn] [response] Now strip the duplicated ToolCard/outcomeChipClass and imports from AgentPanel.\n\n<action>\n{\n  "tool": "write_file",\n  "input": {\n    "path": "xcoder-dojo/src/ui/pages/AgentPanel.tsx",\n    "force": true,\n    "content": "/**\n * P-05 Agent Panel (JARVIS), with P-05b turn-limit banner and P-05c\n * model-not-configured state. P-05a tool cards live in components/ToolCard.\n *\n * Assistant text is untrusted: it renders as escaped text with a visible\n * \"AI-generated\" label. Tool cards are generated by the backend from the\n * ToolCallRecord, never parsed out of model text, so an injection cannot forge\n * one (design T-10).\n */\n\nimport { useEffect, useMemo, useRef, useState } from 'react';\nimport type { AgentRequestState } from '../../contracts';\nimport { useAppActions, useAppState } from '../store';\nimport { TranscriptView } from './TranscriptView';\n\nconst BUSY_STATES = new Set<AgentRequestState>(['thinking', 'awaiting-tool', 'answering', 'stopping']);\n\nexport function AgentPanel(): JSX.Element {\n  const state = useAppState();\n  const actions = useAppActions();\n  const [draft, setDraft] = useState('');\n  const [outcomeFilter, setOutcomeFilter] = useState<'all' | 'ok' | 'refused'>('all');\n  const [delegationGoal, setDelegationGoal] = useState('');\n  const scrollRef = useRef<HTMLDivElement>(null);\n\n  const agent = state.agent;\n  const isBusy = agent ? BUSY_STATES.has(agent.request.state) : false;\n  const modelMissing = !state.settings || state.settings.modelState !== 'configured';\n\n  const entries = useMemo(() => {\n    if (!agent) return [];\n    if (outcomeFilter === 'all') return agent.transcript;\n    return agent.transcript.filter((entry) =>\n      entry.toolCallIds.some((id) => {\n        const record = agent.toolCallsById[id];\n        if (!record) return false;\n        return outcomeFilter === 'ok' ? record.outcome === 'ok' : record.outcome !== 'ok';\n      }),\n    );\n  }, [agent, outcomeFilter]);\n\n  useEffect(() => {\n    const el = scrollRef.current;\n    if (el) el.scrollTop = el.scrollHeight;\n  }, [entries.length, agent?.request.state]);\n\n  const onSend = (): void => {\n    const text = draft.trim();\n    if (text.length === 0 || isBusy) return;\n    setDraft('');\n    void actions.sendAgent(text);\n  };\n\n  const maxChars = agent?.input.maxChars ?? 4000;\n\n  return (\n    <aside className=\"dock dock-right agent-panel\">\n      <header className=\"dock-head\">\n        <span className=\"jarvis-title\">JARVIS</span>\n        {agent ? <span className={`badge badge-${isBusy ? 'busy' : 'idle'}`}>{agent.request.state}</span> : null}\n        <span className=\"dock-head-spacer\" />\n        <button type=\"button\" className=\"icon-btn\" title=\"Conversation history\" onClick={() => actions.setOverlay('history')}>\n          &#9776;\n        </button>\n        <button type=\"button\" className=\"icon-btn\" title=\"Clear conversation\" onClick={() => void actions.clearAgent()}>\n          &#9003;\n        </button>\n      </header>\n\n      {agent && agent.request.turnCap > 0 ? (\n        <div className=\"turn-meter\" title=\"Agent turn budget\">\n          <span className=\"muted small\">\n            turn {agent.request.turnCount}/{agent.request.turnCap}\n          </span>\n          <div className=\"meter-track\">\n            <div\n              className=\"meter-fill\"\n              style={{ width: `${Math.min(100, (agent.request.turnCount / agent.request.turnCap) * 100)}%` }}\n            />\n          </div>\n          <span className=\"muted small\">{agent.requestCapRemaining} req left</span>\n        </div>\n      ) : null}\n\n      {agent?.request.state === 'turn-limit' ? (\n        <div className=\"banner banner-warn\">\n          Turn limit reached ({agent.request.turnCount}/{agent.request.turnCap}). The request stopped\n          cleanly; send a follow-up to continue.\n        </div>\n      ) : null}\n\n      {modelMissing ? (\n        <div className=\"empty-state inline\">\n          <h3>Model not configured</h3>\n          <p className=\"muted\">JARVIS needs an API key before it can answer.</p>\n          <button type=\"button\" className=\"btn btn-primary\" onClick={() => actions.setOverlay('settings')}>\n            Open settings\n          </button>\n        </div>\n      ) : null}\n\n      <div className=\"transcript-toolbar\">\n        {(['all', 'ok', 'refused'] as const).map((filter) => (\n          <button\n            key={filter}\n            type=\"button\"\n            className={`chip chip-btn ${outcomeFilter === filter ? 'chip-active' : ''}`}\n            onClick={() => setOutcomeFilter(filter)}\n          >\n            {filter}\n          </button>\n        ))}\n      </div>\n\n      <div className=\"transcript\" ref={scrollRef}>\n        <TranscriptView entries={entries} toolCalls={agent?.toolCallsById ?? {}} />\n      </div>\n\n      <div className=\"composer\">\n        <textarea\n          className=\"composer-input\"\n          value={draft}\n          maxLength={maxChars}\n          placeholder={modelMissing ? 'Configure a model to chat' : 'Ask JARVIS...'}\n          onChange={(e) => setDraft(e.target.value)}\n          onKeyDown={(e) => {\n            if (e.key === 'Enter' && !e.shiftKey) {\n              e.preventDefault();\n              onSend();\n            }\n          }}\n          disabled={modelMissing}\n          aria-label=\"Message JARVIS\"\n        />\n        <div className=\"composer-bar\">\n          <span className=\"muted small\">\n            {draft.length}/{maxChars}\n          </span>\n          {isBusy ? (\n            <button type=\"button\" className=\"btn btn-danger\" onClick={() => void actions.stopAgent()}>\n              Stop\n            </button>\n          ) : (\n            <button type=\"button\" className=\"btn btn-primary\" onClick={onSend} disabled={draft.trim().length === 0 || modelMissing}>\n              Send\n            </button>\n          )}\n        </div>\n      </div>\n\n      <div className=\"delegation-launcher\">\n        <span className=\"muted small\">Delegation (requires approval)</span>\n        <div className=\"delegation-row\">\n          <input\n            className=\"delegation-goal\"\n            value={delegationGoal}\n            placeholder=\"Goal for the external agent CLI\"\n            onChange={(e) => setDelegationGoal(e.target.value)}\n            aria-label=\"Delegation goal\"\n          />\n          <button\n            type=\"button\"\n            className=\"btn btn-ghost\"\n            disabled={delegationGoal.trim().length === 0 || state.delegation?.state === 'running'}\n            onClick={() => {\n              void actions.launchDelegation(delegationGoal.trim());\n              setDelegationGoal('');\n            }}\n          >\n            Launch\n          </button>\n        </div>\n      </div>\n    </aside>\n  );\n}\n"\n  }\n}\n</action>
[2026-11-16T09:33:15.605Z] [code-st-1de5aa] [request] Observation: {"ok":true,"relPath":"xcoder-dojo/src/ui/pages/AgentPanel.tsx","bytesWritten":6422}
[2026-11-16T09:33:19.208Z] [code-st-1de5aa] [stop=end_turn] [response] Now the Approval sheet (P-07), Delegation view (P-06), and the overlay pages.\n\n<action>\n{\n  "tool": "write_file",\n  "input": {\n    "path": "xcoder-dojo/src/ui/pages/ApprovalSheet.tsx",\n    "content": "/**\n * P-07 Approval Sheet.\n *\n * The modal gate for exactly two actions: file-write and delegation-launch\n * (design T-03). It never enables anything else. The request carries an expiry,\n * and the backend refuses an approval that arrives late.\n */\n\nimport { useEffect, useState } from 'react';\nimport type { ApprovalRequest } from '../../contracts';\nimport { useAppActions } from '../store';\n\nfunction remainingMs(request: ApprovalRequest): number {\n  return Math.max(0, request.expiresAtMs - Date.now());\n}\n\nexport function ApprovalSheet({ request }: { request: ApprovalRequest }): JSX.Element {\n  const actions = useAppActions();\n  const [remaining, setRemaining] = useState(() => remainingMs(request));\n\n  useEffect(() => {\n    const timer = setInterval(() => setRemaining(remainingMs(request)), 250);\n    return () => clearInterval(timer);\n  }, [request]);\n\n  const expired = remaining <= 0;\n  const seconds = Math.ceil(remaining / 1000);\n\n  return (\n    <div className=\"modal-backdrop\" role=\"presentation\">\n      <div className=\"modal approval-sheet\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Approval required\">\n        <header className=\"modal-head\">\n          <h2>Approval required</h2>\n          <span className={`chip ${expired ? 'chip-bad' : 'chip-warn'}`}>\n            {expired ? 'expired' : `${seconds}s left`}\n          </span>\n        </header>\n\n        <div className=\"approval-kind\">\n          <code>{request.kind}</code>\n          <strong>{request.summary}</strong>\n        </div>\n\n        <ul className=\"approval-detail\">\n          {request.detailLines.map((line, index) => (\n            <li key={index}>{line}</li>\n          ))}\n        </ul>\n\n        <p className=\"muted small\">\n          This is the only confirmation gate in the app. Nothing has happened yet; approving runs the\n          action once, and denying is final for this request.\n        </p>\n\n        <div className=\"modal-actions\">\n          <button\n            type=\"button\"\n            className=\"btn btn-ghost\"\n            onClick={() => void actions.respondApproval('denied')}\n          >\n            Deny\n          </button>\n          <button\n            type=\"button\"\n            className=\"btn btn-primary\"\n            disabled={expired}\n            onClick={() => void actions.respondApproval('approved')}\n          >\n            Approve once\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n"\n  }\n}\n</action>
