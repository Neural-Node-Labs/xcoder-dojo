[2026-11-16T10:05:31.561Z] [test-st-bf6f22] Action: edit_file {"path":"xcoder-dojo/src/backend/markdown.ts","old_str":"      const link = /^\\[([^\\]]*)\\]\\(([^)]*)\\)$/.exec(token);\n      if (link) {\n        flush();\n        const href = link[2].trim();\n        const external = /^https?:\\/\\//i.test(href);\n        spans.push({ kind: 'link', text: link[1], href, external });\n      } else {\n        buffer += token;\n      }","new_str":"      const link = /^\\[([^\\]]*)\\]\\(([^)]*)\\)$/.exec(token);\n      if (link) {\n        flush();\n        const href = link[2].trim();\n        if (isSafeHref(href)) {\n          const external = /^https?:\\/\\//i.test(href);\n          spans.push({ kind: 'link', text: link[1], href, external });\n        } else {\n          // Unsafe scheme (javascript:, data:, vbscript:, ...): keep the label\n          // as inert text rather than handing an executable URL to the renderer.\n          spans.push({ kind: 'text', text: link[1] });\n        }\n      } else {\n        buffer += token;\n      }"}
