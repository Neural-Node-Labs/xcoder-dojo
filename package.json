{
  "name": "xcoder-dojo",
  "private": true,
  "version": "0.1.0",
  "description": "Xcoder Dojo - TypeScript UI IDE with an agent panel (implementation of design-st-2c7624)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:smoke": "esbuild test/smoke.ts --bundle --platform=node --format=esm --outfile=test/smoke.mjs --log-level=warning && node test/smoke.mjs",
    "test": "npm run test:unit && npm run test:smoke",
    "regression": "npm run typecheck && npm run test:unit && npm run test:smoke",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
